body {
  font-family: sans-serif;
}
/* Headings*/
h1 {
  font-size: 24pt;
}
h1.chapter {}
h1.appendix {}
h2 {
  font-size: 20pt;
}
h3 {
  font-size: 18pt;
}
h4 {
  font-size: 16pt;
}
h5 {
  font-size: 14pt;
}
h6 {
  font-size: 12pt;
}
/*Paragraph*/
p {
  font-size: 11pt;
}
.draft-comment {
  display: none;
}
.pre {}
.shortdesc {
  font-size: 1.1em;
  color: #666;
  line-height: 1.4em;
  font-weight: 100;
  padding-bottom: 0.8em;
}
/**** Link Styles ****/
a {
  text-decoration: underline;
}
.link {
  display: block;
}
.link>.desc {
  display: none;
}

/**** Table Styles ****/
table {
  width: 100%;
  font-size: 11pt;
  border-collapse: collapse;
}
table .title {
  font-size: 14pt;
  font-weight: bold;
  margin-bottom: 14pt;
  margin-top: 14pt;
}
.tgroup {
  text-align: start;
  table-layout: fixed;
  word-break: break-all;
  word-break: break-word;
}
.thead {
  text-align: left;
  background: #fafafa;
  color: #888;
}
.row {}
.entry {
  padding: 0.5em 1em;
  vertical-align: top;
  border-left-style: solid;
  border-top-style: solid;
  border-right-style: solid;
  border-bottom-style: solid;
  border-left-color: #eeeeee;
  border-top-color: #eeeeee;
  border-right-color: #eeeeee;
  border-bottom-color: #eeeeee;
  border-left-width: 1px;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
}
/**** Simple Table Styles ****/
.simpletable {}
.sthead {
  text-align: left;
  background: #fafafa;
  color: #888;
}
.strow {
  vertical-align: top;
}
.stentry {
  padding: 0.5em 1em;
  border-left-style: solid;
  border-top-style: solid;
  border-right-style: solid;
  border-bottom-style: solid;
  border-left-color: #EEEEEE;
  border-top-color: #EEEEEE;
  border-right-color: #EEEEEE;
  border-bottom-color: #EEEEEE;
  border-left-width: 1px;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
}
/**** Figure & Image Styles ****/
.fig {}
.fig .title {
  font-size: 14pt;
  font-weight: bold;
  margin-bottom: 14pt;
  margin-top: 14pt;
}
.figgroup {}
.image {
  max-width: 100%;
}
.svg-container {
  display: inline-block;
}
video {
  max-height: 100%;
  max-width: 100%;
}
/**** Note Styles ****/
/**** Character Styles ****/
.apiname {
  font-style: italic;
}
.boolean {
  font-style: italic;
}
.delim {}
.equation-block {
  display: inline-block;
}
.filepath {
  font-style: italic;
}
.foreign {
  background: #f5f5f5;
  font-family: monospace;
}
.indexterm {
  display: none;
}
.keyword {}
.keywords {}
.kwd {}
.mathml {
  display: inline-block;
}
.menucascade .uicontrol+.uicontrol:before {
  content: "\00a0\203a\00a0";
}
.ph {}
.shortcut {}
.systemoutput {}
.term {
  font-style: italic;
}
.tm {}
.uicontrol {
  font-weight: bold;
}
.tt {
  font-family: monospace;
}
.state {
  font-style: italic;
}
.userinput {
  font-family: monospace;
}
.var {}
.varname {
  font-style: italic;
}
/**** Footnote Styles ****/
.fn {
  float: footnote;
}
.fn::footnote-call {
  /*content: counter(footnote, decimal);*/
}
.fn::footnote-marker {
  /*content: counter(footnote, decimal);*/
}
.fn[id]::footnote-call {
  display: none;
}
.xref-fn {}
/**** Quote Styles ****/
blockquote {
  background: #fff;
  padding: 1rem;
  font-style: italic;
  line-height: 1.5rem;
  border-left: 4px solid #eee;
}
blockquote::before {
  content: "\"";
}
blockquote::after {
  content: "\"";
}
.cite {
  font-style: italic;
}
.q {}

/**** Task Styles ****/
.choice {
  margin-top: 0.3rem;
  margin-bottom: 0.3rem;
}
.choices {}
.chdesc {}
.chdeschd {}
.chhead {}
.choicetable {}
.choption {}
.choptionhd {}
.chrow {}
.cmd {}
.cmd .prefix-content {
  font-weight: bold;
}
.cmdname {
  font-weight: bold;
}
.example {}
.example>.title {
  font-weight: bold;
  margin-bottom: 0.3rem;
}
.info {}
li:last-child>.info {}
li>.tutorialinfo {}
.p {
  font-size: 11pt;
  margin-bottom: 1em;
}
.p:last-child {
  margin-bottom: 0;
}
.postreq {}
.prereq {}
.result {
  margin-top: 0.1rem;
  margin-bottom: 0.1rem;
}
.step {
  margin-top: 0.3rem;
  margin-bottom: 0.5rem;
}
.step-unordered {
  margin-top: 0.2rem;
  margin-bottom: 0.4rem;
}
.stepresult {
  margin-bottom: 0.5rem;
}
.steps {}
.stepsection {
  display: block;
  margin-left: -0.3rem;
}
.stepxmp {}
.substep {
  margin-top: 0.2rem;
  margin-bottom: 0.4rem;
}
.substeps {}
.tutorialinfo {
  margin-top: 0.3rem;
  margin-bottom: 0.5rem;
}
.tutorialinfo .note {
  margin-bottom: 0.5rem;
}
.tutorialinfo>ol>li:last-child {}
.tutorialinfo>ul>li:last-child {}
.prefix-content {
  display: inline;
}
