/*Created with AEM Guides*/
.frontcover-landsc {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-top: 80px;
  padding-right: 72px;
  padding-bottom: 86px;
  padding-left: 74px;
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
.frontcover-landsc_header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16px;
}
.frontcover-landsc_metadata {
  display: flex;
  flex-direction: column;
  font-family: var(--font-fam-primary);
  font-size: 31.97px;
  font-weight: 400;
  line-height: 35.97px;
}
.frontcover-landsc_logo-image {
  width: 140px;
  height: 36px;
}
.hr {
  border-width: 0.5px;
  border-style: solid;
  border-color: black;
}
.frontcover-landsc_urls {
  margin-top: 8px;
  font-family: Adobe Clean;
  font-size: 12px;
  font-weight: 400;
  line-height: 14px;
  color: #888888;
  text-decoration: none;
}
.frontcover-landsc_container-details {
  display: flex;
  column-gap: 24px;
  margin-top: auto;
}
.frontcover-landsc_cover-image {
  width: 475px;
  height: 467px;
  margin-top: 48px;
}
.frontcover-landsc_additional-details {
  align-self: end;
}
.frontcover-landsc_doctype {
  font-family: var(--font-fam-secondary);
  font-size: 12px;
  font-weight: 350;
  line-height: 14px;
  letter-spacing: 2px;
  text-transform: uppercase;
}
.frontcover-landsc_created-date {
  font-family: var(--font-fam-secondary);
  font-size: 12px;
  font-weight: 700;
  line-height: 14px;
  letter-spacing: 2px;
}
.frontcover-landsc_version-label {
  font-family: var(--font-fam-secondary);
  font-size: 12px;
  font-weight: 350;
  line-height: 14px;
  letter-spacing: 2px;
  text-transform: uppercase;
}
.frontcover-landsc_version {
  font-family: var(--font-fam-secondary);
  font-size: 12px;
  font-weight: 700;
  line-height: 14px;
  letter-spacing: 2px;
}