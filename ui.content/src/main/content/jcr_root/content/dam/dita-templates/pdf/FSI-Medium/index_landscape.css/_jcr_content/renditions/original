#index_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 0.5px solid #AEAEAE;
  padding-bottom: 4px;
  margin-top: 40px;
}
#index_header_title {
  font-family: var(--font-fam-secondary);
  font-size: 1.3rem;
  line-height: 1.3rem;
  font-weight: 400;
  color: #013220;
  margin-bottom: 8px;
}
#index_header_titlealts {
  font-family: var(--font-fam-primay);
  font-size: 0.75rem;
  line-height: 0.875rem;
  font-weight: 400;
  color: #013220;
  /* margin-bottom: 40px; */
  /* padding-bottom: 40px; */
}
.idx-body {
  column-count: unset;
  column-fill: unset;
}
.idx-title {
  column-span: all;
}
.idx-keyword-group {
  font-weight: bold;
  font-size: 12pt;
  margin-top: 16pt;
}
.idx-keyword-group:first-of-type {
  margin-top: 0pt;
  display: none;
}
.idx-unit {
  padding-bottom: 0px;
  padding: unset;
  margin: unset;
}
.idx-keyword {
  margin: unset;
  padding: unset;
}
.idx-name {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  line-height: 0.875rem;
  font-weight: 350;
  color: #013220;
  /* margin-bottom: 16px; */
}
.idx-link {
  text-decoration: none;
  font-weight: 700;
}
.idx-child {
  padding-left: 0pt;
}
/* #index_footer {
  border-top: 0.5px solid #2C343B;
} */
#index_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-size: 0.625rem;
  line-height: 0.75rem;
  font-weight: 400;
  color: #2C343B;
  padding-top: 8px;
  margin: unset;
}
#index_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: 0.625rem;
  line-height: 0.75rem;
  font-weight: 400;
  color: #2C343B;
  /* margin: unset; */
}
a.book-idx-link.idx-link {
  color: #013220;
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  line-height: 0.875rem;
  font-weight: 700;
}
/* .book-idx-child.idx-child {
  column-count: 2;
  column-gap: 85px;
} */
.idx-unit p:first-of-type {
  margin: unset;
  padding: unset;
}
.index_footer {
  padding-bottom: 40px;
}
.index_footer_text {
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  color: #var(--color-secondary);
  margin: 0;
}
.index_publish-date {
  font-family: var(--font-fam-primary);
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
}