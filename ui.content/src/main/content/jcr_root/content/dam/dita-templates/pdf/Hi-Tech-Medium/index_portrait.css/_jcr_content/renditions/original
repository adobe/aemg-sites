.index_title {
  font-size: var(--text-xl);
  line-height: var(--text-xl-lh);
  font-weight: 500;
  font-family: var(--font-fam-secondry);
  color: var(--color-accent);
  margin: 0;
}
.index_footer {
  background-color: var(--color-secondary);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 73px 24px 73px;
}
.index_footer_text {
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  color: var(--color-accent);
  margin: 0;
}
.index_footer_page_number {
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 500;
  font-family: var(--font-fam-primary-medium);
  color: var(--color-accent);
  margin: 0;
}