.global-config,
:root {
  /* font family */
  --font-fam-primary:  "Inter", serif;
  --font-fam-secondry: "Urbanist", serif;
}
.color-config,
:root {
  --color-accent: #0C1256;
  --color-primary: #01EA57;
  --color-secondary: #E8F1FF;
  --color-tertiary: #2C343B;
  --color-neutral: #979797;
  --color-link: #0F85EC;
}