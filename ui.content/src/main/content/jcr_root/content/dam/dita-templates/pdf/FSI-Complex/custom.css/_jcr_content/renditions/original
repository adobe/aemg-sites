/* single line statement css*/
.restriction,
.note.caution,
.tip {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 8px;
  padding: 8px 0px;
  border-top: 0.5px solid #D8D8D8;
  border-bottom: 0.5px solid #D8D8D8;
  border-left: unset;
  background-color: unset;
  margin: 45px 20px;
  font-family: var(--font-fam-primary);
  font-size: 15px;
  line-height: var(--text-sm-lh);
  font-weight: 400;
  color: var(--color-primary);
  
}
.restriction .prefix-content,
.note.caution .prefix-content,
.tip .prefix-content,
.note.danger .prefix-content {
  font-size: 16px;
}
.note.danger {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 8px;
  padding: 8px 0px;
  border-top: 0.5px solid #D8D8D8;
  border-bottom: 0.5px solid #D8D8D8;
  border-left: unset;
  background-color: unset;
  margin: 20px;
  font-size: var(--text-sm);
  font-weight: 400;
  line-height: 18px;
  color: #2C343B;
}
.note.danger .prefix-content,
.restriction .prefix-content,
.note.caution .prefix-content,
.tip .prefix-content {
  font-weight: bold;
  display: inline-flex;
  gap: 8px;
  justify-content: flex-start;
  position: relative;
  top: 0px;
  margin-right: 8px;
  align-items: flex-start;
  font-family: var(--font-fam-primary);
    font-size: var(--text-base);
    line-height: var(--text-base-lh);
    font-weight: 600;
    color: var(--color-primary);
}
.restriction .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/restriction.png);
  background-size: 15px 15px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}.note.caution .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/caution.png);
  background-size: 15px 15px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}
.tip .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/tip.png);
  background-size: 15px 15px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}
/* long message hazardement statement css */
.hazardstatement.warning,
.hazardstatement.danger,
.hazardstatement.notice {
  background-color: #FFFFFF;
  border: none;
  margin: 20px;
  width: 95.7%;
}
.restriction.note.hazardstatement {
  display: block;
  border: none;
  background: none;
}

.danger.note.hazardstatement,
.caution.note.hazardstatement {
  display: inline-table;
  border: unset;
    width: 95.7%;
  background: none;
}
.hazardstatement .prefix-content,
.danger.note.hazardstatement .prefix-content,
.caution.note.hazardstatement .prefix-content {
  background: none;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  padding: 8px 0px 8px 0px;
  border-top: 0.5px solid #D8D8D8;
  border-bottom: 0.5px solid #D8D8D8;
  color: #2C343B;
}
.danger .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/danger.png);
  background-size: 15px 15px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}
.warning .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/restriction.png);
  background-size: 15px 15px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}
.caution .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/caution-img.png);
  background-size: 15px 15px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}
.notice .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/notice.png);
  background-size: 15px 15px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}
.hazardstatement {
  font-size: 16px;
}
.hazardstatement .messagepanel {
  list-style-type: disc;
  margin-top: 16px;
  padding-inline-start: 38px;
}
.hazardstatement .ul .li {
  background: white;
  padding: 0px;
  font-family: Inter;
  letter-spacing: 0px;
  font-size: var(--text-sm);
  font-weight: 400;
  line-height: 18px;
  color: #2C343B;
}