/**** Heading Styles ****/
h1 {
  font-size: 24pt;
  margin-bottom: 24pt;
}
h2 {
  font-size: 20pt;
}
h3 {
  font-size: 18pt;
}
h4 {
  font-size: 16pt;
}
h5 {
  font-size: 14pt;
}
h6 {
  font-size: 12pt;
}
h1.chapter {
  --autonumber: autonumber;
  --prefix-size: 33px;
  --prefix-fixed-size: true;
  --prefix-gap: 0px;
  --vertical-spacing: 0px;
  --list-indent: 0px;
  counter-reset: lot-count fig-count subsection h2\.chapter1 0;
  undefined: undefined;
  position: relative;
  column-span: all;
  margin-bottom: 24pt;
  margin-left: calc(var(--list-indent) + var(--prefix-size) + var(--prefix-gap));
  margin-top: calc(var(--vertical-spacing) / 2);
}
h2.chapter {
  counter-reset: h3\.chapter1 0;
}
h2.chapter:before {
  counter-increment: h2\.chapter1;
  content: counter(h1\.chapter1, decimal) "." counter(h2\.chapter1) " ";
}
h3.chapter:before {
  counter-increment: h3\.chapter1;
  content: counter(h1\.chapter1, decimal) ". " counter(h2\.chapter1, decimal) ". " counter(h3\.chapter1) " ";
}
h1.chapter:before {
  font-family: PP Editorial New;
  counter-increment: h1\.chapter1;
  content: " " counter(h1\.chapter1, decimal)" ";
  text-align: left;
  position: absolute;
  left: calc(-0.5* var(--prefix-size) - var(--prefix-gap));
  margin-right: var(--prefix-gap);
  width: var(--prefix-size);
  overflow: hidden;
  top: 0px;
  color: #013220;
  padding-left: 7px;
}
h1.appendix {}
/**** Paragraph Styles ****/
p {
  font-size: 11pt;
}
.draft-comment {
  display: none;
}
.pre {}
.shortdesc {
  font-size: 1.1em;
  color: #666;
  line-height: 1.4em;
  font-weight: 100;
  padding-bottom: 0.8em;
}
/**** Link Styles ****/
a {
  text-decoration: underline;
}
