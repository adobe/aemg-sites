/*Created with AEM Guides*/
.frontcover p {
  margin: 0px;
}
.frontcover {
  background-color: var(--color-accent);
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 80px 97px 73px 50px;
}
.frontcover_logo-image {
  width: 144px;
  height: 26px;
}
.frontcover_cover-image-wrapper {
  display: flex;
  justify-content: center;
  gap: 24px;
  margin-top: auto;
  margin-bottom: auto;
}
.frontcover_cover-image {
  max-width: unset !important;
}
.frontcover_textdata .frontcover_mainbooktitle {
  font-size: 30px;
  line-height: 40px;
  font-weight: 500;
  color: #FFFFFF;
  display: inline-block;
  margin-bottom: 8px;
  font-family: var(--font-fam-secondry);
}
.frontcover_textdata .frontcover_booktitlealt {
  font-size: 14px;
  line-height: 20px;
  font-family: var(--font-fam-primary-regular);
  font-weight: 400;
  color: #FFFFFF;
  display: inline-block;
  margin-bottom: 40px;
}
.frontcover_critdates {
  font-size: 11px;
  line-height: 14px;
  font-family: var(--font-fam-primary-medium);
  font-weight: 500;
  color: #01EA57;
}