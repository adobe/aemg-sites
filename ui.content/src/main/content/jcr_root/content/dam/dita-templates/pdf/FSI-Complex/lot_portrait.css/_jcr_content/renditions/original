.lot_header {
  /* margin-top: 50px;
  text-align: left; */
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 0.5px solid var(--color-gray);
  padding-bottom: 4px;
  margin-top: 50px;
}
.lot_header_title {
  font-family: var(--font-fam-primay);
  font-size: var(--text-xl);
  line-height: var(--text-xl-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 8px;
  margin-top: 0px;
}
.lot_header_titlealts {
  font-family: var(--font-fam-primay);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin-bottom: 24px;
}
.lot_content .lot-level-1,
.lot-level-1 {
  font-family: var(--font-fam-primay);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 350;
  color: var(--color-primary);
  margin-bottom: 8px;
}
.lot_content .lot-level-1::after,
.lot-level-1::after {
  color: var(--color-primary);
  font-weight: 700;
}
/* .lot_footer {
  border-top: 0.5px solid #2C343B;
} */
.lot_footer_product-name {
  font-family: var(--font-fam-primay);
  font-weight: 400;
  padding-top: 8px;
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  color: var(--color-secondary);
  padding-top: 8px;
  margin: unset;
}
.lot_footer_urls {
  font-family: var(--font-fam-primay);
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  color: #0F85EC;
}
.lot_footer_hr {
  border: 0.5px solid var(--color-secondary);
  margin: 0;
  padding: 0;
}
.lot-body {
  column-count: 2;
  column-gap: 85px;
}
.lot_content,
.lot-body {
  padding-top: 60px;
}
.header_logo {
  max-height: 17px;
  max-width: 33px;
}