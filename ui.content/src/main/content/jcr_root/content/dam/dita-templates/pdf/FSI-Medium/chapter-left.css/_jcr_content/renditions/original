.chapter_leftpage_header {
  display: flex;
  justify-content: space-between;
  border-bottom: 0.5px solid var(--color-gray);
  padding-bottom: 8px;
  margin-top: 40px;
}
.chapter_leftpage_header_page-number {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-primary);
}
.chapter_leftpage_header_logo {
  background-image: url('../../../aemguidesDALP/fsi/images/logo-img.png');
  background-size: 100% 100%;
  width: 33px;
  height: 17px;
}
.chapter_leftpage_footer {
  margin-bottom: 24px;
}
.chapter_leftpage_footer_text_first {
  font-family: var(--font-fam-primary);
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin: 0;
}
.chapter_leftpage_footer_text {
  font-family: var(--font-fam-primary);
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin: 0;
}
.chapter_leftpage_footer_number {
  font-family: var(--font-fam-primary);
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  padding-right: 3px;
}
.chapter_leftpage_footer_urls {
  color: var(--color-secondary);
  text-decoration: none;
}
h1.title.chapter {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xl);
  line-height: var(--text-2xl-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin: 0;
  display: inline-block;
  max-width: 48.15%;
  padding-right: 24px;
  box-sizing: border-box;
  vertical-align: top;
  margin-top: 20px;
}
.shortdesc {
  font-family: var(--font-fam-primary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin: 0;
  display: inline-block;
  max-width: 51.85%;
  box-sizing: border-box;
  margin-top: 20px;
}
.chart-container {
  background-color: #F9F9F9;
}
.thead {
  font-family: var(--font-fam-primary);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 500;
  color: var(--color-primary);
  background-color: var(--color-primary-light);
  border: 0.5px solid var(--color-light-gray);
  text-align: left;
}
b,
bold-text {
  font-weight: 700;
  color: #0C1256;
}
.tbody {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 400;
  color: var(--color-primary);
  border: 0.5px solid var(--color-light-gray);
}
.tbody .entry {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
}
.tbody b {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 16px;
}
.table {
  margin-bottom: 40px;
}
ul {
  margin: 0;
  padding-inline-start: 20px;
}
li {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin-bottom: 16px;
}
.entry {
  padding: 8px 16px;
}
.vertical-label {
  transform: rotate(90deg);
  /* Rotates text */
  white-space: nowrap;
  /* Prevents text from wrapping */
}