.chapter_firstpage_header {
  display: none;
}
.chapter_firstpage_footer {
  display: none;
}
.chapter_firstpage_content {
  display: flex;
  height: 1124px;
}
.chapter_firstpage_content_left {
  background-color: var(--color-primary);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 80px 59px 198px 73px;
  flex-basis: 444px;
  box-sizing: border-box;
}
.chapter_firstpage_title {
  font-family: var(--font-fam-primary);
  font-size: var(--text-4xl);
  line-height: var(--text-4xl-lh);
  font-weight: 400;
  color: var(--color-accent);
}
.chapter_firstpage_metadata {
  /* padding-right: 30px; */
  width: 225px;
}
.chapter_firstpage_desc {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xl);
  line-height: var(--text-2xl-lh);
  font-weight: 400;
  color: var(--color-accent);
  margin: 0;
}
.chapter_firstpage_descalt {
  font-family: var(--font-fam-primary);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
  color: var(--color-accent);
  margin: 10px 0 0 0;
}
.chapter_firstpage_content_right {
  background-color: var(--color-blue);
  flex-basis: 350px;
  padding-top: 82px;
  padding-left: 190px;
  box-sizing: border-box;
}
.chapter_firstpage_logo {
  background-image: url('../../../aemguidesDALP/fsi/images/logo-img1.png');
  background-size: 100% 100%;
  width: 87px;
  height: 45px;
}
