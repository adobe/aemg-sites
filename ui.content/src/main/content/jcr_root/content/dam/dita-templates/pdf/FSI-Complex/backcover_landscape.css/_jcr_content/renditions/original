.backcover_landsc_content {
  box-sizing: border-box;
  width: 500px;
  height: 290px;
  background-color:  var(--color-white, #FFFFFF);
  padding: 40px 110px 90px 40px;
  display: flex;
  gap: 16px;
  position: absolute;
  bottom: 0;
  right: 0;
}
.backcover_landsc_logo {
  width: 78px;
  height: 60px;
}
.backcover_landsc_author-addressdetails {
  font-family: var(--font-fam-primary);
  font-size: 12px;
  line-height: 16px;
  font-weight: 400;
  color: var(--color-primary);
  margin: 0;
}
