.backcover_content {
  box-sizing: border-box;
  width: 500px;
  height: 290px;
  background-color: #FFFFFF;
  padding: 40px 110px 90px 40px;
  display: flex;
  gap: 16px;
  position: absolute;
  bottom: 0;
  right: 0;
}
.backcover_logo {
  width: 78px;
  height: 60px;
}
