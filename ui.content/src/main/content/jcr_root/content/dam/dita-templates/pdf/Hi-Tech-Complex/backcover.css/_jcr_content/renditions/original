/*Created with AEM Guides*/
.backcover-details {
  display: flex;
  flex-direction: column;
  gap: 63px;
  position: fixed;
  bottom: 0;
  right: 7px;
}
.backcover_organization-details {
  display: flex;
  flex-direction: column;
  gap: 40px;
}
.backcover_org-contact-label,
.backcover_org-address-label, .backcover_org-socials-label {
  font-family: Adobe Clean;
  font-size: 12px;
  font-weight: 700;
  line-height: 14px;
  text-align: left;
  color: #000000;
  margin: 0;
}
.backcover_contact-container, .backcover_address-container, .backcover_socials-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.backcover_org-contactnumbers, .backcover_org-emailaddresses
,.backcover_org-addressdetails, .backcover_org-socials{
  font-family: Adobe Clean;
  font-size: 12px;
  font-weight: 400;
  line-height: 14px;
  text-align: left;
  color: #000000;
  margin: 0;
}
.main-description {
  font-family: Urbanist;
  font-size: 28px;
  font-weight: 500;
  line-height: 34px;
  text-align: left;
  color: #010101;
  margin: 0;
}