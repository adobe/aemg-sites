<?xml version="1.0" encoding="UTF-8"?>
<settings>
  <type>pdf</type>
  <name>Sample Template</name>
  <version>2020.6.0</version>
  <multiLayouts type="boolean">true</multiLayouts>
  <origTableContinuationText>Continued on page %page-num%</origTableContinuationText>
  <destTableContinuationText>Continued from page %page-num%</destTableContinuationText>
  <modifyHeadings type="boolean">true</modifyHeadings>
  <notDisplayPageNo>false</notDisplayPageNo>
  <leaderFormat>dotted</leaderFormat>
  <tableContinuation type="boolean">true</tableContinuation>
  <useUserToc type="boolean">true</useUserToc>
  <toclevel type="number">4</toclevel>
  <startChapterFromNewPage type="boolean">false</startChapterFromNewPage>
  <startChapterFromEvenPage type="boolean">false</startChapterFromEvenPage>
  <startChapterFromOddPage type="boolean">true</startChapterFromOddPage>
  <startChapterFromCurrentPage type="boolean">false</startChapterFromCurrentPage>
  <startTopicsFromNewPage type="boolean">false</startTopicsFromNewPage>
  <displayChapter type="boolean">true</displayChapter>
  <pdfTrimmark type="boolean">false</pdfTrimmark>
  <pdfBleedmark type="boolean">false</pdfBleedmark>
  <pdfRegistrationmark type="boolean">false</pdfRegistrationmark>
  <pdfColorbar type="boolean">false</pdfColorbar>
  <pdfLineweight></pdfLineweight>
  <pdfMediaboxSize></pdfMediaboxSize>
  <pdfMediaboxWidth></pdfMediaboxWidth>
  <pdfMediaboxHeight></pdfMediaboxHeight>
  <pdfColorSpace>RGB</pdfColorSpace>
  <pdfLineColor></pdfLineColor>
  <pdfIccProfileName></pdfIccProfileName>
  <pdfIccFileUrl></pdfIccFileUrl>
  <pdfIccFilePath></pdfIccFilePath>
  <bleedboxMargin></bleedboxMargin>
  <crossRef>
    <title>See &quot;{title}&quot; on page 1 {page}</title>
    <heading>See &quot;{text}&quot; on page {page}</heading>
    <description>{description}</description>
    <bookmark>See &quot;{bookmarkText}&quot; on page {page}</bookmark>
    <figure>See &quot;{captionText}&quot; on page {page}</figure>
    <table>See &quot;{captionText}&quot; on page {page}</table>
    <paragraph>See on chapter {chapter}</paragraph>
  </crossRef>
  <bookLists type="array">
    <bookListsitem>
      <name>customLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <path>Frontcover_landscape.plt</path>
      <label>Frontcover_landscape</label>
    </bookListsitem>
    <bookListsitem>
      <name>tocLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <label>TOC</label>
      <disabled type="boolean">false</disabled>
    </bookListsitem>
    <bookListsitem>
      <name>topicLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <label>Chapters &amp; Topics</label>
      <disabled type="boolean">true</disabled>
    </bookListsitem>
    <bookListsitem>
      <name>customLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <path>Blank.plt</path>
      <label>Blank</label>
    </bookListsitem>
    <bookListsitem>
      <name>lofLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <label>List of Figures</label>
      <disabled type="boolean">false</disabled>
    </bookListsitem>
    <bookListsitem>
      <name>lotLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <label>List of Tables</label>
      <disabled type="boolean">false</disabled>
    </bookListsitem>
    <bookListsitem>
      <name>indexLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <label>Index</label>
      <disabled type="boolean">false</disabled>
    </bookListsitem>
    <bookListsitem>
      <name>gloLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <label>Glossary</label>
      <disabled type="boolean">false</disabled>
    </bookListsitem>
    <bookListsitem>
      <name>bibLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <label>Citations</label>
      <disabled type="boolean">false</disabled>
    </bookListsitem>
    <bookListsitem>
      <name>customLayout</name>
      <mergeMode>none</mergeMode>
      <showInTOC type="boolean">true</showInTOC>
      <path>Backcover_landscape.plt</path>
      <label>Backcover_landscape</label>
    </bookListsitem>
  </bookLists>
  <hyperlinkGlossary type="boolean">true</hyperlinkGlossary>
  <pdfpagespersheet type="boolean">false</pdfpagespersheet>
  <layout>Common</layout>
  <coverPageLayout>Frontcover_Portrait</coverPageLayout>
  <backPageLayout>Backcover_Portrait</backPageLayout>
  <emptyPageLayout>Blank_Portrait</emptyPageLayout>
  <tocLayout>TOC_Portrait</tocLayout>
  <topicLayout>Chapter_Portrait</topicLayout>
  <gloLayout>Glossary_Portrait</gloLayout>
  <indexLayout>Index_Portrait</indexLayout>
  <bibLayout>Citations</bibLayout>
  <lotLayout>LOT_Portrait</lotLayout>
  <lofLayout>LOF_Portrait</lofLayout>
</settings>