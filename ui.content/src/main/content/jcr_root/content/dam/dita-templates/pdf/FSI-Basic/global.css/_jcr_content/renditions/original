/* Define the font faces once */
@font-face {
  font-family: 'Manrope';
  src: url('/content/dam/aemguidesDALP/fonts/manrope/Manrope-Regular.ttf') format('truetype');
  font-weight: 400;
  font-style: normal;
}
@font-face {
  font-family: 'Manrope';
  src: url('/content/dam/aemguidesDALP/fonts/manrope/Manrope-Medium.ttf') format('truetype');
  font-weight: 500;
  font-style: normal;
}
@font-face {
  font-family: 'Manrope';
  src: url('/content/dam/aemguidesDALP/fonts/manrope/Manrope-SemiBold.ttf') format('truetype');
  font-weight: 600;
  font-style: normal;
}
@font-face {
  font-family: 'Manrope';
  src: url('/content/dam/aemguidesDALP/fonts/manrope/Manrope-Bold.ttf') format('truetype');
  font-weight: 700;
  font-style: normal;
}
/* Define variables for font usage */
:root {
  --font-fam-primary: 'Manrope', sans-serif;
  --font-size-base: 16px;
}
/* Apply font settings to various elements */
body {
  font-family: var(--font-fam-primary);
  font-weight: var(--font-fam-regular);
}
strong,
.semibold {
  font-weight: var(--font-fam-semibold);
}

.color-config,
:root {
  --color-accent: #FFFFFF;
  --color-primary: #013220;
  --color-primary-light: #E2F8F0;
  --color-primary-dark: #02403D;
  --color-secondary: #2C343B;
  --color-tertiary: #FDA14A;
  --color-neutral: #D8D8D8;
  --color-dark: #002417;
  --color-black: #222222;
  --color-blue: #C6DFD9;
  --color-light-gray: #ACACAC;
  --color-gray: #AEAEAE;
}
.typography-config,
:root {
  /* converted form 16px base size*/
  --text-4xs: 0.563rem; /* 9px */
  --text-4xs-lh: 0.75rem; /* 12px */
  
  --text-3xs: 0.625rem; /* 10px */
  --text-3xs-lh: 0.75rem; /* 12px */
  
  --text-2xs: 0.688rem; /* 11px */
  --text-2xs-lh: 0.875rem; /* 14px */
  
  --text-xs: 0.75rem; /* 12px */
  --text-xs-lh: 1rem; /* 16px */
  
  --text-sm: 0.875rem; /* 14px */
  --text-sm-lh: 1.25rem; /* 20px */
  
  --text-base: 1rem; /* 16px */
  --text-base-lh: 1.5rem; /* 24px */
  
  --text-lg: 1.125rem; /* 18px */
  --text-lg-lh: 1.5rem; /* 24px */
  
  --text-xl: 1.25rem; /* 20px */
  --text-xl-lh: 1.75rem; /* 28px */
  
  --text-2xl: 1.5rem; /* 24px */
  --text-2xl-lh: 2rem; /* 32px */
  
  --text-3xl: 1.875rem; /* 30px */
  --text-3xl-lh: 2.5rem; /* 40px */
  
  --text-4xl: 2.25rem; /* 36px */
  --text-4xl-lh: 3rem; /* 48px */
  
  --text-5xl: 3rem; /* 48px */
  --text-5xl-lh: 3.875rem; /* 62px */
  
  --text-6xl: 3.75rem; /* 60px */
  --text-6xl-lh: 4.75rem; /* 76px */
  
  --text-7xl: 4.5rem; /* 72px */
  --text-7xl-lh: 5.625rem; /* 90px */
  
  --text-8xl: 6rem; /* 96px */
  --text-8xl-lh: 7.75rem; /* 124px */
  
  --text-9xl: 8rem; /* 128px */
  --text-9xl-lh: 9.625rem; /* 154px */
}
/* Text size classes */
.p.text-xs,
.text-xs {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
}
.p.text-sm,
.text-sm {
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
}
.p.text-base,
.text-base {
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
}
.p.text-lg,
.text-lg {
