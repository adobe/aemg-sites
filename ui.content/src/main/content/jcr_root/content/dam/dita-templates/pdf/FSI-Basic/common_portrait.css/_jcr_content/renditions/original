body {
  font-family: var(--font-fam-primary);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
  color: var(--color-primary);
}
.chapter_header {
  display: flex;
  justify-content: space-between;
  border-bottom: 0.5px solid var(--color-gray);
  padding-bottom: 8px;
  margin-bottom: 30px;
}
.chapter_header_page-number {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-primary);
}
.chapter_header_logo {
  width: 33px;
  height: 17px;
}
.chapter_footer {
  padding-bottom: 24px;
}
.chapter_footer_text_container {
  display: flex;
  gap: 4px;
  padding-bottom: 4px;
}
.chapter_footer_text {
  font-family: var(--font-fam-primary);
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin: 0;
}
.chapter_footer_number {
  font-family: var(--font-fam-primary);
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin: 0;
}
.chapter_footer_urls {
  color: var(--color-secondary);
  text-decoration: none;
}
.chapter-body {
  padding-bottom: 30px;
}
h1.title {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xl);
  line-height: var(--text-2xl-lh);
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 8px;
}
h2.title {
  font-family: var(--font-fam-primary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 600;
  color: var(--color-primary);
}
h1.title.chapter {
  padding-left: 18px;
}
h1.title::before {
  font-family: var(--font-fam-primary);
  padding-left: 15px;
  color: var(--color-primary);
}
.shortdesc {
  font-family: var(--font-fam-primary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 36px;
}
.link,
.topic a {
  font-family: var(--font-fam-primary);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 500;
  color: var(--color-primary);
  text-decoration: underline;
}
.thead {
  font-family: var(--font-fam-primary);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 500;
  color: var(--color-primary);
  background-color: var(--color-primary-light);
  border: 0.5px solid var(--color-light-gray);
  text-align: left;
}
b,
bold-text {
  font-weight: 700;
  color: var(--color-primary);
}
.tbody {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 400;
  color: var(--color-primary);
  border: 0.5px solid var(--color-light-gray);
}
.tbody .entry {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
}
.tbody b {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 16px;
}
.table {
  margin-bottom: 40px;
}
ul {
  margin: 0;
  padding-inline-start: 20px;
}
li {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin-bottom: 16px;
}
.entry {
  padding: 8px 16px;
}
.table_img_container {
  text-align: center;
}
.table_img {
  width: 98px;
  height: 98px;
  padding-top: 16px;
  display: block;
}