.chapter_right_body {
  position: relative;
}
.chapter_rightpage_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 0 40px 0;
}
.chapter_rightpage_header_lang {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  letter-spacing: 1px;
  font-weight: 500;
  font-family: var(--font-fam-primary-medium);
  color: var(--color-accent);
  position: absolute;
  left: 7%;
  top: 21px;
  margin: 0;
}
.chapter_rightpage_header_number {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  letter-spacing: 1px;
  font-weight: 500;
  font-family: var(--font-fam-primary-medium);
  color: var(--color-accent);
  background-color: var(--color-primary);
  position: absolute;
  right: 0;
  top: 0;
  height: 56px;
  width: 56px;
  margin: 0;
  justify-content: center;
  display: flex;
  align-items: center;
}
.chapter_rightpage_footer {
  background-color: var(--color-secondary);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 27px 60px 21px 73px;
  margin-top: 40px;
}
.chapter_rightpage_footer_text {
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  color: var(--color-accent);
  margin: 0;
}
.chapter_rightpage_footer_page_number {
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 500;
  font-family: var(--font-fam-primary-medium);
  color: var(--color-accent);
  margin: 0;
}
h1.title.chapter {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xl);
  line-height: var(--text-2xl-lh);
  font-weight: 700;
  font-family: var(--font-fam-primary-bold);
  color: var(--color-accent);
  margin: 0;
  padding-left: 30px;
  padding-bottom: 15px;
}
h2.title.chapter, 
h3.title.chapter {
  font-size: var(--text-2xl);
  line-height: var(--text-2xl-lh);
}
h1.title::before {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xl);
  line-height: var(--text-2xl-lh);
  font-weight: 700;
  font-family: var(--font-fam-primary-bold);
  color: var(--color-accent);
  padding-left: 15px;
  padding-right: 15px;
}
h2.title {
  font-family: var(--font-fam-primary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 500;
  font-family: var(--font-fam-primary-medium);
  color: var(--color-accent);
}
.shortdesc {
  font-family: var(--font-fam-primary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  color: var(--color-accent);
  margin: 0;
}
.display_flex {
  display: flex;
  /* gap: 35px; */
}
.flex_col1 {
  padding-left: 35px;
  flex-basis: 30%;
}
.flex_col2 {
  flex-basis: 70%;
}
.chapter_title {
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 700;
  color: var(--color-accent);
  font-family: var(--font-fam-primary-bold);
  margin: 0;
  padding-bottom: 25px;
}
.chapter_title_alt {
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
  color: var(--color-accent);
  font-family: var(--font-fam-primary-regular);
  margin: 0;
}
.figure_container {
  display: flex;
  gap: 24px;
}
.figure_content_wrapper {
  width: 218px;
}
.fig_content {
  width: 218px;
  height: 210px;
  background-color: var(--color-secondry-white);
  padding: 16px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
  position: relative;
}
.desc_circle {
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 700;
  font-family: var(--font-fam-primary-bold);
  color: var(--color-primary);
  margin: 0;
  padding: 8px 16px;
  border-radius: 20px;
  background-color: var(--color-accent);
  display: inline-block;
  position: absolute;
  left: 16px;
  top: 16px;
}
.figure_info {
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
  color: var(--color-accent);
  font-family: var(--font-fam-primary-regular);
  margin: 0;
}
.table {
  padding-top: 36px;
  padding-bottom: 40px;
}
.entry {
  border: 0.5px solid var(--color-secondary-blue);
}
thead .entry {
  padding: 10px 16px;
  background-color: var(--color-secondary);
  color: var(--color-accent);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 500;
  font-family: var(--font-fam-primary-medium);
  margin: 0;
}
tbody .entry {
  padding: 12px 16px 12px 16px;
  color: var(--color-accent);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  margin: 0;
  word-wrap: break-word;
}
tbody .entry b {
  color: var(--color-accent);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 500;
  font-family: var(--font-fam-primary-medium);
}
tbody .entry ul {
  margin: 0;
  padding-inline-start: 15px;
}
tbody .entry ul li {
  color: var(--color-accent);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
}
.chapter_body_heading {
  color: var(--color-accent);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 700;
  font-family: var(--font-fam-primary-bold);
  margin: 0;
  padding-bottom: 8px;
}
.chapter_body_description {
  color: var(--color-accent);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  margin: 0;
}
.caution_conatiner {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 8px;
  padding-top: 8px;
  border-top: 0.5px solid var(--color-neutral);
  border-bottom: 0.5px solid var(--color-neutral);
  margin-top: 40px;
}
/*.caution {
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  font-style: italic;
  margin: 0;
  color: var(--color-accent);
} */
.caution b {
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 700;
  font-family: var(--font-fam-primary-bold);
  font-style: italic;
  margin: 0;
  color: var(--color-accent);
}
h2.chapter_sub-titles {
  color: var(--color-accent);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 700;
  font-family: var(--font-fam-primary-bold);
}
body {
  color: var(--color-accent);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
}
.caution_img {
  margin: 0;
  width: 24px;
  height: 24px;
}
span:has(img.caution_img) {
  display: inline-block !important;
  width: 24px;
  height: 24px;
}
div.caution.p {
  margin-bottom: 0;
}
.caution_conatiner figure {
  width: 24px;
  height: 24px;
}
figure {
  margin: 0;
}
.glo-link {
  font-family: var(--font-fam-primary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  color: var(--color-accent);
  display: inline-block;
  margin-top: 10px;
}