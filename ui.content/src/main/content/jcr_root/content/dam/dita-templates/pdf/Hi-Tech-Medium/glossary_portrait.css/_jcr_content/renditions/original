.glossary_title {
  font-size: var(--text-xl);
  line-height: var(--text-xl-lh);
  font-weight: 500;
  font-family: var(--font-fam-secondry);
  color: var(--color-accent);
  margin: 0;
}
.glo-body {
  display: grid;
  grid-template-columns: auto auto;
  grid-column-gap: 80px;
  grid-row-gap: 16px;
  margin-top: 30px;
}
.rh-back-matter-wrapper {
  padding-left: 73px;
  padding-right: 73px;
}
.glo-term,
glossterm {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 700;
  font-family: var(--font-fam-primary-bold);
  color: var(--color-accent);
}
.glo-definition,
glossdef {
  font-family: var(--font-fam-primary);
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  color: var(--color-accent);
}
.glossary_footer {
  background-color: var(--color-secondary);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 38px 73px 38px 73px;
}
.glossary_footer_text {
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  color: var(--color-accent);
  margin: 0;
}
.glossary_footer_page_number {
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 500;
  font-family: var(--font-fam-primary-medium);
  color: var(--color-accent);
  margin: 0;
}