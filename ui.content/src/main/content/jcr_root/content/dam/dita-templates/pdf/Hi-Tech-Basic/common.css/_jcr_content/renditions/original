.fig {
  display: flex;
  flex-direction: column-reverse;
  margin: 0px;
}
.fig .prefix-content {
  display: none !important;
}
.fig_image-wrapper {
  flex-basis: 58%;
}
.fig_image-wrapper .placement-inline {
  background-color: var(--color-secondry-white);
  padding: 60px 39px 60.5px 38px;
}
.fig_image-wrapper .title {
  font-size: 9px;
  line-height: 12px;
  font-weight: 400;
  font-family: var(--font-fam-primary-regular);
  color: var(--color-tertiary);
  margin-bottom: 0px;
  margin-top: 8px;
  text-align: center;
}