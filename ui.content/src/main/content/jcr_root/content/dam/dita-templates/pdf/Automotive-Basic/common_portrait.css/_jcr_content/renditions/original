/*Created with AEM Guides*/
.chapter_firstpage_header {}
.chapter_header_title {
  font-family: PP Editorial New;
  font-size: var(--text-xl);
  font-weight: 400;
  line-height: var(--text-xl-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: #010101;
  margin-bottom: 60%;
}
.chapter_header_titlealts {}
.chapter_header_mainbooktitle {}
.chapter_header_chapter-number p {
  border-top: 2px solid;
  display: inline-flex;
  width: 144px;
  position: relative;
  bottom: -60px;
  text-align: right;
  font-family: PP Editorial New;
  font-size: var(--text-xl);
  font-weight: 400;
  line-height: var(--text-xl-lh);
  padding: 8px 0px;
}
.chapter_header_chapter-number {
  text-align: end;
}
.chapter_header_page-number {}
.chapter_firstpage_cover-image {
  width: 100%;
}
.chapter_firstpage_footer {}
.chapter_footer_mainbooktitle {}
.chapter_footer_product-name {}
.chapter_footer_copyright {}
.chapter_footer_product-brand {}
.chapter_footer_urls {}
.chapter_footer_version {}
.chapter_footer_email {}
.chapter_footer {
  border-top: 0.5px solid var(--color-tertiary-opa-70);
  color: var(--color-tertiary);
  display: flex;
  justify-content: space-between;
  align-content: center;
  padding-top: 8px;
  font-family: var(--font-fam-secondary);
}
.chapter_footer_page-number {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-sm);
  font-weight: 700;
  line-height: var(--text-sm-lh);
  color: var(--color-accent);
}
.chapter_footer_organization {
  font-family: Adobe Clean;
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  text-align: end;
}
.chapter_leftpage_header {}
.chapter_leftpage_footer {}
.chapter_rightpage_header {}
.chapter_rightpage_footer {}
/* inbuilt class styling  */
.chapter_sub-titles,
.p.chapter_sub-titles {
  font-family: PP Editorial New;
  font-size: var(--text-base);
  font-weight: 400;
  line-height: var(--text-base-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: var(--color-secondary);
}
body .section:first-of-type h2 {
  margin-top: 0;
}
.chapter-body .p {
  font-family: Adobe Clean;
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: var(--color-tertiary);
}
h1.chapter {
  font-family: PP Editorial New;
  font-size: var(--text-2xl);
  font-weight: 400;
  line-height: var(--text-2xl-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: var(--color-primary);
  border-top: 1px solid var(--color-primary);
  display: inline-block;
  padding-top: 4px;
}
.chapter-body .title_chapter-number {
  color: var(--color-neutral);
  font-family: PP Editorial New;
  font-size: var(--text-2xl);
  font-weight: 400;
  line-height: var(--text-2xl-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
}
/* Table Styling */
.thead {
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 600;
  color: var(--color-accent);
  /* Using --color-primary for text */
  background-color: var(--color-neutral);
  /* Using --color-tertiary for background */
  border: 0.5px solid var(--color-accent);
  /* Using --color-secondary for border */
  text-align: left;
}
b,
bold-text {
  font-weight: 600;
  color: var(--color-primary);
  /* Using --color-primary */
}
.tbody {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  /* Using --color-secondary */
  border: 0.5px solid var(--color-accent);
  /* Using --color-secondary for border */
}
.tbody .entry {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  /* Using --color-secondary */
}
.tbody b {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 600;
  color: var(--color-secondary);
  /* Using --color-secondary */
  margin-bottom: 16px;
}
.table {
  margin-bottom: 40px;
}
ul {
  margin: 0;
  padding-inline-start: 20px;
}
li {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  /* Using --color-secondary */
  margin-bottom: 16px;
}
.entry {
  padding: 8px 16px;
  border-color: var(--color-accent);
}
/* Notes */

.chapter_info {
  background-color: #D9E6EB;
  padding: 8px 40px 8px 16px;
  color: #2C343B;
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  margin-bottom: 40px;
  margin-top: 50px;
}
.note {
  border-left: 4px solid var(--color-primary);
  background-color: var(--color-neutral);
  color: var(--color-secondary);
}
.note .prefix-content {
  color: var(--color-primary);
}