.toc_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 0.5px solid var(--color-gray);
  padding-bottom: 4px;
  margin-top: 40px;
}
.toc_header_title {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xl);
  line-height: var(--text-2xl-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin: 0;
}
.toc_header_logo {
  height: 24px;
  width: 60px;
}
.toc-body {
  padding-top: 50px;
  column-count: 2;
  column-gap: 112px;
}
.toc_footer {
  padding-bottom: 41px;
}
.toc_footer_text {
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  font-family: var(--font-fam-primary);
  margin: 0;
}
.toc_footer_product-name {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 700;
  color: var(--color-secondary);
}
.toc_publish-date {
  font-family: var(--font-fam-primary);
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
}
.toc-level-1 {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 700;
  color: var(--color-primary);
  margin-top: 50px;
  position: relative;
  text-transform: uppercase;
}
.toc-level-1:first-child {
  margin-top: 0;
}
.toc-level-1::after {
  display: none;
}
.toc-level-2 {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-primary);
  padding-top: 9px;
  padding-left: var(--toc-level-2-gap);
  padding-left: 30px;
}
.toc-level-2::after {
  font-weight: 700;
}
.toc-level-1,
.toc-level-2,
.toc-level-3,
.toc-level-4,
.toc-level-5,
.toc-level-6 {
  text-indent: 0px;
}