.toc_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 0.5px solid var(--color-gray-light);
  padding-bottom: 4px;
  margin-top: 40px;
}

.toc_header_title {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xl);
  line-height: var(--text-xl-lh);
  font-weight: 400;
  color: var(--color-primary-dark);
  margin: 0;
}

.toc_header_logo {
  height: 17px;
  width: 33px;
}

.toc-body {
  column-count: 2;
  column-gap: 112px;
}

.toc_footer {
  padding-bottom: 41px;
}

.toc_footer_text {
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 400;
  color: var(--color-secondary-dark);
  margin: 0;
}

.toc_footer_product-name {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 700;
  color: var(--color-secondary-dark);
}

.toc_publish-date {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: 400;
  color: var(--color-secondary-dark);
}

.toc-level-1 {
  font-family: var(--font-fam-primary);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 700;
  color: var(--color-primary-dark);
  margin-top: 50px;
  position: relative;
}

.toc-level-1:first-child {
  margin-top: 0;
}

.toc-level-1::after {
  display: none;
}

.toc-level-2 {
  font-family: var(--font-fam-primary);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
  color: var(--color-primary-dark);
  padding-top: 9px;
  padding-left: var(--toc-level-2-gap, 30px); 
}

.toc-level-2::after {
  font-weight: 700;
}

.toc-level-1,
.toc-level-2,
.toc-level-3,
.toc-level-4,
.toc-level-5,
.toc-level-6 {
  text-indent: 0px;
}
