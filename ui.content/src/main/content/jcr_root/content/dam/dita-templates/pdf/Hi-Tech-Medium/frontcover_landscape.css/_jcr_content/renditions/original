.frontcover_landsc_content {
  padding-top: 80px;
  padding-right: 73px;
  padding-left: 73px;
}
.frontcover_landsc_content_container {
  width: 648px;
}
.frontcover_landsc_mainbooktitle {
  font-size: var(--text-3xl);
  line-height: var(--text-3xl-lh);
  font-weight: 500;
  margin: 0;
  color: var(--color-accent);
  padding-bottom: 8px;
}
.frontcover_landsc_titlealt {
  font-size: var(--text-lg);
  line-height: var(--text-lg-lh);
  font-weight: 400;
  margin: 0;
  color: var(--color-accent);
  padding-bottom: 40px;
}
.frontcover_landsc_cover_img {
  width: 976px;
  height: 286px;
}
.frontcover_landsc_footer {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40px;
  padding-right: 73px;
  padding-left: 73px;
}
.frontcover_landsc_metadata {
  display: flex;
  align-items: flex-end;
}
.frontcover_landsc_version {
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  margin: 0;
  color: var(--color-accent);
}
.break_line {
  background-color: var(--color-accent);;
  height: 15px;
  width: 0.8px;
  margin: 0 10px;
}
.frontcover_landsc_publish_date {
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  margin: 0;
  color: var(--color-accent);
}
.frontcover_landsc_logo {
  width: 69px;
  height: 51px;
}