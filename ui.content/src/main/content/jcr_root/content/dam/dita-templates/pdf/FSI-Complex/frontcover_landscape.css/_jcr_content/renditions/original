  background-image: url('../../../aemguidesDALP/fsi/images/histogram-img.png');
  background-size: 100% 100%;
  width: 323px;
  height: 231px;
}
.frontcover_landsc_logo_container {
  width: 799px;
  height: 230px;
  padding: 64px 61px 64px 62px;
  display: flex;
  align-items: center;
  gap: 24px;
  position: absolute;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  box-sizing: border-box;
}
.frontcover_landsc_logo {
  background-image: url('../../../aemguidesDALP/fsi/images/frontcover-logo.png');
  background-size: 100% 100%;
  width: 132px;
  height: 102px;
}
.frontcover_landsc_text {
  font-family: var(--font-fam-primary);
  font-size: 24px;
  line-height: 32px;
  font-weight: 400;
  color: #222222;
  margin: 0;
  width: 520px;
}