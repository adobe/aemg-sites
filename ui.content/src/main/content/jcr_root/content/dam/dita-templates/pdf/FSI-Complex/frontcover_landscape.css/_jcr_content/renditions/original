  height: 422.34px;
  position: absolute;
  right: 78px;
  bottom: 25%;
  z-index: 1;
}
.piechart_landsc_image {
  background-image: url('../../../aemguidesDALP/fsi/images/pie-chart-img.png');
  background-size: 100% 100%;
  width: 83px;
  height: 107.17px;
  position: absolute;
  bottom: 8%;
  left: 30px;
  z-index: 1;
}
.histogram_landsc_image_container {
  position: absolute;
  bottom: 0;
  left: 0;
}
