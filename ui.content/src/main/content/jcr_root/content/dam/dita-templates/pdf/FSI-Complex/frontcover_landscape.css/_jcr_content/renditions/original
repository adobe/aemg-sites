  color: #FFFFFF;
  margin: 0;
}
.frontcover_landsc_publish-date {
  font-family: var(--font-fam-primary);
  font-size: 24px;
  line-height: 32px;
  font-weight: 400;
  color: #FFFFFF;
  margin: 0;
  padding-top: 4px;
}
.barchart_landsc_image_bg_color {
  background-color: #002417;
  width: 500px;
  height: 290px;
  position: absolute;
  right: 0;
  bottom: 28%;
}
.barchart_landsc_image {
  background-image: url('../../../aemguidesDALP/fsi/images/bar-chart-img.png');
  background-size: 100% 100%;
