/*Created with AEM Guides*/
#glossary_header {
  margin-bottom: 0px;
  text-align: left;
}
#glossary_header_title {
  font-family: var(--font-fam-secondary);
  font-size: 1.3rem;
  line-height: 1.3rem;
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 8px;
}
#glossary_header_titlealts {
  font-family: var(--font-fam-primary);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  margin-bottom: 40px;
}
#glossary_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  margin: 0;
  padding-top: 8px;
}
#glossary_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-link);
}
#glossary-footer {
  display: flex;
  flex-direction: column;
  align-items: baseline;
  row-gap: 1px;
  border-top: 0.5px solid #2C343B;
  justify-content: flex-start;
  padding-bottom: 108px;
  color: var(--color-tertiary);
}
.glo-term {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: 1rem;
  font-weight: 700;
  color: var(--color-secondary);
}
.glo-definition {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 350;
  line-height: 1rem;
  text-align: left;
  color: var(--color-tertiary);
}
glossterm {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 700;
  color: var(--color-secondary);
}
.glo-body {
  display: grid;
  grid-template-columns: auto auto;
  grid-column-gap: 84px;
  grid-row-gap: 16px;
  margin-top: 30px;
}
.left-right-main-container {
  display: flex;
  column-gap: 80px;
}
.left-side {
  width: 50%;
}
.left-side .left-side-image {
  width: 438px;
  height: 478px;
}
.right-side {
  width: 50%;
}