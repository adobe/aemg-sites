body {
  font-family: var(--font-fam-secondary);
}
.cite,
cite,
term,
.term,
i,
.i {
  color: var(--color-primary);
  font-style: italic;
  font-size: var(--text-base);
}
q,
.q {
  font-style: italic;
  font-size: var(--text-base);
  border-left: 5px solid var(--color-accent);
  margin: 20px 0;
  padding-left: 35px;
  color: var(--color-primary);
  background-color: var(--color-neutral-light);
  line-height: 1.6;
  font-family: var(--font-fam-secondary);
  position: relative;
  width: 95%;
}
q::before,
.q::before {
  content: "“";
  font-size: 2em;
  color: var(--color-accent);
  position: absolute;
  top: -9px;
  left: 7px;
}
q::after,
.q::after {
  content: "”";
  font-size: 2em;
  color: var(--color-accent);
  position: absolute;
  bottom: -21px;
  right: unset;
  margin-left: 5px;
}
/* Style for the entire definition list */
.dl {
  width: unset;
  margin-block: 2rem;
  padding: 1rem 0;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  /* border-radius: 8px; */
  /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); */
}
/* Header style */
.dlhead {
  font-family: var(--font-fam-secondary);
  margin-bottom: 1rem;
  padding: 1rem;
  transition: all 0.3sease;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  border-left: 3px solid var(--color-accent);
  background-color: var(--color-neutral-light);
  color: var(--color-primary);
  break-inside: avoid;
}
.dthd {
  font-family: var(--font-fam-secondary);
  font-weight: bold;
  color: var(--color-dark-grey, #2c3e50);
  margin-bottom: 0.5rem;
}
.ddhd {
  line-height: 1.5;
  margin-left: 1rem;
  font-family: var(--font-fam-secondary);
  color: var(--color-secondary);
}
/* Entry block styles */
.dlentry {
  margin-bottom: 1rem;
  padding: 1rem;
  transition: all 0.3s ease;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  border-left: 3px solid var(--color-accent);
  background-color: var(--color-neutral-light);
  color: var(--color-primary);
  break-inside: avoid;
}
/* Styling for the <dt> (definition term) */
.dt {
  font-weight: bold;
  color: var(--color-dark-grey, #2c3e50);
  margin-bottom: 0.5rem;
}
.dt::after {
  content: " :";
}
/* Styling for the <dd> (definition description) */
.dd {
  line-height: 1.5;
  margin-left: 1rem;
  font-family: var(--font-fam-secondary, var(--font-fam-primary));
  color: var(--color-secondary);
}
/* Container for steps */
ol.steps {
  /* Limit the width */
  /* Center it */
  /* Initialize the counter */
  list-style: none;
  padding: 0;
  margin: 0;
  position: relative;
  max-width: 600px;
  margin: 30px auto;
  font-family: 'Helvetica N eue', sans-serif;
  counter-reset: step-counter;
}
/* Each step */
li.step {
  position: relative;
  padding-left: 50px;
  /* Space for the vertical line and step icon */
  margin-bottom: 40px;
  /* Vertical spacing between steps */
  transition: transform 0.3s ease;
  font-size: var(--text-lg);
  line-height: var(--text-lg-lh);
  font-weight: 400;
  font-family: var(--font-fam-secondary);
  color: var(--color-primary);
}
/* Vertical line connecting steps */
ol.steps::before {
  /* Position the line in the center */
  content: '';
  position: absolute;
  top: 0;
  left: 25px;
  width: 2px;
  height: 100%;
  background-color: var(--color-bg-light, #e0e0e0);
  z-index: 1;
}
/* Circle steps with numbers */
li.step::before {
  content: counter(step-counter);
  counter-increment: step-counter;
  position: absolute;
  left: 8px;
  top: 16px;
  transform: translateY(-50%);
  width: 30px;
  height: 30px;
  background: var(--color-accent, green);
  border-color: var(--color-accent, green);
  color: var(--color-white);
  font-weight: bold;
  font-size: 16px;
  border-radius: 50%;
  border: 3px solid #fff;
  text-align: center;
  line-height: 24px;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
}
/* Active step */
li.step.active::before {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
/* Completed step */
li.step.completed::before {
  background-color: var(--color-accent);
  /* Green for completed step */
  border-color: var(--color-accent);
  /* Border color for completed */
}
/* Info box for additional information */
div.itemgroup.info {
  background-color: var(--color-white-light, #f3f3f3);
  padding: 10px;
  border-left: 3px solid var(--color-primary);
  font-size: 14px;
  margin-top: 10px;
}
span.prefix-content {
  font-weight: bold;
}
/* Choices for the third step */
ul.choices {
  margin-top: 10px;
  padding-left: 20px;
  list-style-type: square;
}
li.choice {
  margin-bottom: 8px;
  font-size: 14px;
}
/* Styling for cascading menu */
.ph.menucascade {
  padding: 5px;
  border-radius: 3px;
  margin-left: 5px;
  font-weight: 600;
}
/* Display inline content */
.display-inline {
  display: inline-block;
  margin-right: 5px;
}
/* Styling for the span elements */
.ph.uicontrol {
  font-weight: normal;
  color: var(--color-primary);
}
.fig,
fig {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background-color: var(--color-grey-lighter, #f4f4f4);
  /* Subtle background */
  border-radius: 8px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  /* Light shadow for elegance */
  padding: 20px;
  max-width: 500px;
  margin: 30px auto;
  /* Centering with some margin */
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  /* Smooth transition */
}
/* Styling for the figcaption */
.fig figcaption,
figcaption {
  font-size: 1.5em;
  font-weight: bold;
  color: var(--color-black-grey, #333);
  margin-top: 15px;
  font-family: 'Arial', sans-serif;
}
/* Image styling */
.image,
image {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  /* Ensures the image scales beautifully */
}
