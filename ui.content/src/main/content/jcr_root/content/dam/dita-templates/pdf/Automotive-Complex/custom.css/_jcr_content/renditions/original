body {
  font-family: var(--font-fam-secondary);
}
.cite,
cite,
term,
.term,
i,
.i {
  color: var(--color-tertiary);
  font-style: italic;
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 600;
  font-family: var(--font-fam-secondary);
  letter-spacing: 0.5px;
}
q,
.q {
  font-style: italic;
  font-size: var(--text-base);
  margin: 20px 0;
  padding-left: 35px;
  color: var(--color-primary);
  background-color: var(--color-light-blue-bg);
  line-height: var(--text-base-lh);
  font-family: var(--font-fam-secondary);
  position: relative;
  width: 95%;
  padding: 10px 0px 10px 35px;
}
q::before,
.q::before {
  content: "“";
  font-size: 2em;
  color: var(--color-accent);
  position: absolute;
  top: unset;
  left: 12px;
  font-family: auto;
}
q::after,
.q::after {
  content: "”";
  font-size: 2em;
  color: var(--color-accent);
  position: absolute;
  top: unset;
  bottom: unset;
  right: unset;
  margin-left: 5px;
  font-family: auto;
}
/* Style for the entire definition list */
.dl {
  width: unset;
  margin-block: 2rem;
  padding: 1rem 0;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
}
/* Header style */
.dlhead {
  font-family: var(--font-fam-secondary);
  margin-bottom: 1rem;
  padding: 1rem;
  transition: all 0.3sease;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  background-color: var(--color-light-blue-bg);
  color: var(--color-primary);
  break-inside: avoid;
}
.dthd {
  font-family: var(--font-fam-secondary);
  font-weight: 400;
  color: var(--color-primary, #2c3e50);
  margin-bottom: 0.5rem;
  font-size: var(--text-xl);
  line-height: var(--text-xl-lh);
}
.ddhd {
  margin-left: 1rem;
  font-family: var(--font-fam-secondary);
  color: var(--color-tertiary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
}
.dthd::after {
  content: " :";
}
/* Entry block styles */
.dlentry {
  margin-bottom: 1rem;
  padding: 1rem;
  transition: all 0.3s ease;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  background-color: var(--color-light-blue-bg);
  color: var(--color-primary);
  break-inside: avoid;
}
/* Styling for the <dt> (definition term) */
.dt {
  font-family: var(--font-fam-secondary);
  font-weight: 400;
  color: var(--color-primary, #2c3e50);
  margin-bottom: 0.5rem;
  font-size: var(--text-xl);
  line-height: var(--text-xl-lh);
}
.dt::after {
  content: " :";
}
/* Styling for the <dd> (definition description) */
.dd {
  margin-left: 1rem;
  font-family: var(--font-fam-secondary);
  color: var(--color-tertiary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
}
/* Container for steps */
ol.steps {
  list-style: none;
  padding: 0;
  margin: 0;
  position: relative;
  max-width: 600px;
  margin: 30px auto;
  font-family: 'Helvetica N eue', sans-serif;
  counter-reset: step-counter;
}
/* Each step */
li.step {
  position: relative;
  padding-left: 50px;
  margin-bottom: 40px;
  transition: transform 0.3s ease;
  font-size: var(--text-lg);
  line-height: var(--text-lg-lh);
  font-weight: 400;
  font-family: var(--font-fam-secondary);
  color: var(--color-primary);
}
ol.steps::before {
  content: '';
  position: absolute;
  top: 0;
  left: 25px;
  width: 2px;
  height: 100%;
  background-color: var(--color-bg-light, #e0e0e0);
  z-index: 1;
}
/* Circle steps with numbers */
li.step::before {
  content: counter(step-counter);
    counter-increment: step-counter;
    position: absolute;
    left: 11px;
    top: 16px;
    width: 30px;
    height: 30px;
    background: var(--color-accent, green);
    color: var(--color-white);
    border-radius: 50%;
    border: none;
    text-align: center;
    z-index: 2;
    font-family: Inter;
    font-weight: 700;
    font-size: 15px;
    line-height: 19.2px;
    letter-spacing: 0px;
}
/* Active step */
li.step.active::before {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
/* Completed step */
li.step.completed::before {
  background-color: var(--color-accent);
  border-color: var(--color-accent);
}
/* Info box for additional information */
div.itemgroup.info {
  background-color: var(--color-white-light, #f3f3f3);
  padding: 10px;
  border-left: 3px solid var(--color-primary);
  font-size: 14px;
  margin-top: 10px;
}
span.prefix-content {
  font-weight: bold;
}
/* Choices for the third step */
ul.choices {
  margin-top: 10px;
  padding-left: 20px;
  list-style-type: square;
}
li.choice {
  margin-bottom: 8px;
  font-size: 14px;
}
/* Styling for cascading menu */
.ph.menucascade {
  padding: 5px;
  border-radius: 3px;
  margin-left: 5px;
  font-weight: 600;
}
/* Display inline content */
.display-inline {
  display: inline-block;
  margin-right: unset;
}
/* Styling for the span elements */
.ph.uicontrol {
  font-weight: normal;
  color: var(--color-primary);
}
.fig,
fig {
  border: 1px dotted var(--color-link);
  text-align: center;
  background-color: unset;
  padding: 20px;
  max-width: 500px;
  margin: 30px auto;
}
/* Styling for the figcaption */
.fig figcaption,
figcaption {
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 500;
  margin-top: 15px;
  font-family: var(--font-fam-secondary);
  color: var(--color-primary);
}
/* Image styling */
.image,
image {
  max-width: 100%;
  height: auto;
}
/* Styling for unordered lists */
ul {
  list-style-type: none;
  margin: 0;
  padding-inline-start: 40px;
}
ul li {
  background: unset;
  border-radius: 5px;
  transition: background-color 0.3s ease;
  position: relative;
  margin-bottom: 0px;
  padding: 10px 10px 8px 0px;
}
ul li:not(.hazardstatement)::before {
  content: '•';
  position: absolute;
  left: -20px;
  font-size: 1.5em;
  color: var(--color-accent, #821616);
}
.hazardstatement li::before,
.note.hazardstatement ul li::before {
  content: none;
}

ol {
  list-style: none;
  padding: 0;
  counter-reset: list-counter;
  margin: 20px 0px 32px 0px;
}
ol li {
  margin-bottom: 20px;
  counter-increment: list-counter;
  position: relative;
  padding-left: 40px;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
