.toc_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 4px;
  margin-top: 80px;
  border-bottom: 0.5px solid var(--color-gray);
}
.toc_header_title {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xl);
  line-height: var(--text-2xl-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin: 0;
}
.toc_header_logo {
  height: 17px;
  width: 33px;
}
.toc-body {
  padding-top: 90px;
}
.toc_footer {
  margin-bottom: 20px;
  margin-top : 60px;
}
.toc_footer_text {
  font-family: var(--font-fam-primary);
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin: 0;
}
.toc_footer_product-name {
  font-family: var(--font-fam-primary);
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 700;
  color: var(--color-secondary);
}
.toc_publish-date {
  font-family: var(--font-fam-primary);
  font-size: var(--text-3xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
}
.toc-level-1 {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 700;
  letter-spacing: 1px;
  color: var(--color-primary);
  margin-top: 48px;
  margin-bottom: 11px;
}
.toc-level-1:first-child {
  margin-top: 0;
}
.toc-level-1::after {
  display: none;
}
.toc-level-2 {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 17px;
  padding-left: var(--toc-level-2-gap);
}
.toc-level-1,
.toc-level-2,
.toc-level-3,
.toc-level-4,
.toc-level-5,
.toc-level-6 {
  text-indent: 0px;
}
