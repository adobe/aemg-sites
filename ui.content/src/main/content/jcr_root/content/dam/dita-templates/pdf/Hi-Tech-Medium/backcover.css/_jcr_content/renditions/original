.backcover_header {
  padding-top: 69px;
  padding-left: 73px;
}
.backcover_logo {
  width: 144px;
  height: 106px;
}
.backcover_text {
  margin-bottom: 69px;
}
.backcover_description {
  font-size: 24px;
  line-height: 32px;
  font-weight: 500;
  color: #0C1256;
  margin: 0;
}
.backcover_content {
  width: 304px;
  position: absolute;
  bottom: 86px;
  right: 81px;
}
.backcover_contact_label {
  font-size: 12px;
  line-height: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #0C1256;
  padding-bottom: 10px;
  margin: 0;
  text-transform: uppercase;
}
.backcover_address_label {
  font-size: 12px;
  line-height: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #0C1256;
  padding-bottom: 10px;
  margin: 0;
  text-transform: uppercase;
}
.backcover_socials_label {
  font-size: 12px;
  line-height: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #0C1256;
  padding-bottom: 10px;
  margin: 0;
  text-transform: uppercase;
}
.backcover_phoneno_container,
.backcover_email_container,
.backcover_socials_link_container {
  display: flex;
  align-items: center;
  gap: 8px;
}
.backcover_phoneno_container {
  padding-bottom: 10px;
}
.backcover_phone_number,
.backcover_email,
.backcover_address,
.backcover_social {
  font-size: 9px;
  line-height: 12px;
  font-weight: 400;
  color: #0C1256;
  margin: 0;
}
.backcover_phone_img {
  width: 16px;
  height: 16px;
}
.backcover_email_img {
  width: 16px;
  height: 10.89px;
}
.backcover_insta_img {
  width: 16px;
  height: 16px;
}
.backcover_contact_container,
.backcover_address_container{
  margin-bottom: 40px;
}