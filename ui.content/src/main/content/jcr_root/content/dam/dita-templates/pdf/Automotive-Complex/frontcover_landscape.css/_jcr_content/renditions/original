/* Created with AEM Guides */
.frontcover-landsc {
  display: flex;
  position: absolute;
  box-sizing: border-box;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  height: 100%;
}
.frontcover-landsc_left {
  flex-basis: 56.8%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background-position: bottom left;
}
.frontcover-landsc_logo-image {
  width: 185px;
  height: 47px;
}
.frontcover-landsc_logo-background {
  padding-top: 80px;
  padding-right: 10px;
  padding-left: 73px;
  background: var(--frontcover-landsc-bg);
  height: 165px;
  box-shadow: -11px 25px 44px 16px var(--frontcover-landsc-bg-blur);
}
.frontcover-landsc_left_footer {
  display: flex;
  align-items: end;
  gap: 40px;
  justify-content: flex-start;
  padding: 0 0 29px 37px;
}
.frontcover-landsc_version-label {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 300;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: var(--frontcover-text-color);
  text-transform: uppercase;
}
.frontcover-landsc_language-label {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 350;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: var(--frontcover-text-color);
}
.frontcover-landsc_version {
  font-weight: 700;
}
.frontcover-landsc_language {
  font-weight: 700;
}
.frontcover-landsc_right {
  flex-basis: 43.2%;
  display: flex;
  flex-direction: column;
  padding: 80px 0px 0px 40px;
  background-color: var(--frontcover-right-bg);
}
.frontcover-landsc_right_header {
  color: var(--frontcover-text-color);
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 350;
  line-height: var(--text-xs-lh);
  letter-spacing: 2px;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  margin-bottom: 48px;
}
.frontcover-landsc_doctype {
  font-weight: 350;
}
.frontcover-landsc_created-date .frontcover-landsc_created-date {
  font-weight: 700;
}
.frontcover-landsc_right-metadata {
  font-family: var(--font-fam-primary);
  font-size: var(--text-5xl);
  line-height: var(--text-5xl-lh);
  font-weight: 400;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: var(--frontcover-text-color);
  margin-bottom: 4px;
}
.frontcover-landsc_right-description {
  /* No specific styling needed for this class yet */
}
.frontcover-landsc_description {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 400;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: var(--frontcover-text-color);
}
.frontcover-landsc_right_footer {
  margin-top: auto;
  display: flex;
  justify-content: flex-end;
}
.frontcover-landsc_urls {
  text-decoration: none;
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  margin-bottom: 50px;
  margin-right: 74px;
  color: var(--frontcover-text-color);
}