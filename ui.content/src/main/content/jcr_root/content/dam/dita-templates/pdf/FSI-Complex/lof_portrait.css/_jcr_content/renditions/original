.lof_content,
.lof-body {
  padding-top: 60px;
}
.lof_header_title {
  font-family: var(--font-fam-secondary);
  font-size: 1.3rem;
  line-height: 1.3rem;
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 8px;
  margin-top: 0px;
}
.lof_header_titlealts {
  font-family: var(--font-fam-primay);
  font-size: 0.75rem;
  line-height: 0.875rem;
  font-weight: 400;
  color: var(--color-secondary);
  margin-bottom: 24px;
}
.lof_content .lof-level-1,
.lof-level-1 {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  line-height: 0.875rem;
  font-weight: 350;
  color: var(--color-primary);
  margin-bottom: 16px;
}
.lof_content .lof-level-1::after,
.lof-level-1::after {
  color: var(--color-primary);
  font-weight: 700;
}
/* .lof_footer {
  margin-bottom: 40px;
} */
.lof_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-weight: 400;
  padding-top: 8px;
  font-size: 0.625rem;
  line-height: 0.75rem;
  color: var(--color-secondary);
  margin: unset;
  padding-top: 8px;
}
.lof_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: 0.625rem;
  line-height: 0.75rem;
  font-weight: 400;
  color: #0F85EC;
}
/* .lof_footer_hr {
  border: 0.5px solid #2C343B;
  margin: 0;
  padding: 0;
