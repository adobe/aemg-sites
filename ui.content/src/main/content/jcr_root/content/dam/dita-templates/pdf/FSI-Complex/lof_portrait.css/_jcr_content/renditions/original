.lof_content,
.lof-body {
  padding-top: var(--spacing-lg);
}

.lof_header_title {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-lg);
  line-height: var(--text-lg-lh);
  font-weight: var(--font-fam-regular);
  color: var(--color-primary);
  margin-bottom: var(--spacing-sm);
  margin-top: 0;
}

.lof_header_titlealts {
  font-family: var(--font-fam-primary);
  font-size: var(--text-2xs);
  line-height: var(--text-2xs-lh);
  font-weight: var(--font-fam-regular);
  color: var(--color-secondary);
  margin-bottom: var(--spacing-md);
}

.lof_content .lof-level-1,
.lof-level-1 {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: var(--font-fam-light);
  color: var(--color-primary);
  margin-bottom: var(--spacing-md);
}

.lof_content .lof-level-1::after,
.lof-level-1::after {
  color: var(--color-primary);
  font-weight: var(--font-fam-semibold);
}

.lof_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-weight: var(--font-fam-regular);
  padding-top: var(--spacing-sm);
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  color: var(--color-secondary);
  margin: unset;
}

.lof_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: var(--font-fam-regular);
  color: var(--color-link);
}

.lof-body {
  column-count: 2;
  column-gap: var(--spacing-lg);
}

.lof_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 0.5px solid var(--color-gray);
  padding-bottom: var(--spacing-xs);
  margin-top: var(--spacing-lg);
}

.header_logo {
  max-height: 17px;
  max-width: 33px;
}
