.lof-body {
  column-count: 2;
  column-gap: 85px;
}
.lof_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 0.5px solid var(--color-gray);
  padding-bottom: 4px;
  margin-top: 50px;
}
.header_logo {
  max-height: 17px;
  max-width: 33px;
}