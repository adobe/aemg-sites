.toc_header {
  display: none;
}
.toc-body {
  column-count: 2;
  column-gap: 80px;
  padding: 0 73px 135px 73px;
}
.toc-level-1 {
  font-size: 12px;
  line-height: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #0C1256;
  margin: 30px 0 4px 0;
}
.toc-level-1:first-child {
  margin-top: 0;
}
.toc-level-1::after {
  display: none;
}
.toc-level-2 {
  font-size: 12px;
  line-height: 16px;
  font-weight: 400;
  color: #0C1256;
  margin:0;
  padding-bottom: 6px;
  border-left: 0.5px solid #AEAEAE;
  padding-left: 8px;
}
.toc-level-2:last-child {
  padding-bottom: 0;
}
.toc_content_title {
  font-size: 21px;
  line-height: 21px;
  font-weight: 500;
  color: #0C1256;
  padding-bottom: 40px;
  margin: 85px 73px 0 73px;
}
.toc_footer {
  background-color: #E8F1FF;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 73px 24px 71px;
}
.toc_footer_text {
  font-size: 9px;
  line-height: 12px;
  font-weight: 400;
  color: #0C1256;
  margin: 0;
}
.toc_footer_page_number {
  font-size: 16px;
  line-height: 24px;
  font-weight: 500;
  color: #0C1256;
  margin: 0;
}
.toc-level-1,
.toc-level-2,
.toc-level-3,
.toc-level-4,
.toc-level-5,
.toc-level-6 {
  text-indent: 0px;
}