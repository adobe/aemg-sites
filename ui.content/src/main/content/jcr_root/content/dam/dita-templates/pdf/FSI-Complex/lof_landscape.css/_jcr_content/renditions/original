.lof_content,
.lof-body {
  padding-top: 60px;
}
.lof_header_title {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xl);
  line-height: var(--text-xl-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 8px;
}
.lof_header_titlealts {
  font-family: var(--font-fam-primary);
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  margin-bottom: 40px;
}
.lof_content .lof-level-1,
.lof-level-1 {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 350;
  color: var(--color-primary);
  margin-bottom: 16px;
}
.lof_content .lof-level-1::after,
.lof-level-1::after {
  color: var(--color-primary);
  font-weight: 700;
}
.lof_footer {
  margin-bottom: 0px;
}
.lof_footer_product-name {
  font-family: var(--font-fam-primary);
  font-weight: 400;
  padding-top: 8px;
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  color: var(--color-secondary);
  margin: unset;
}
.lof_footer_urls {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: #0F85EC;
}
.lof_footer_hr {
  border: 0.5px solid var(--color-secondary);
  margin: 0;
  padding: 0;
}
.lof-body {
  column-count: 2;
  column-gap: 60px;
}
.lof_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 0.5px solid var(--color-gray);
  padding-bottom: 4px;
  margin-top: 50px;
}
.header_logo {
  max-height: 24px;
  max-width: 60px;
}