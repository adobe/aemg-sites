.frontcover_header {
  margin-top: 80px;
  margin-left: 73px;
}
.frontcover_logo {
  width: 144px;
  height: 26px;
}
.frontcover_content {
  padding: 100px 73px 40px 73px;
}
.frontcover_content_container {
  display: flex;
  padding-top: 40px;
}
.frontcover_metadata_left {
  display: flex;
  align-items: flex-end;
  width: 40%
}
.frontcover_metadata_right {
  width: 60%
}
.frontcover_version {
  font-size: 11px;
  line-height: 14px;
  font-weight: 400;
  margin: 0;
  color: #FFFFFF;
}
.frontcover_publish_date {
  font-size: 11px;
  line-height: 14px;
  font-weight: 400;
  margin: 0;
  color: #FFFFFF;
}
.break_line {
  background-color: #FFFFFF;
  height: 15px;
  width: 0.8px;
  margin: 0 10px;
}
.frontcover_mainbooktitle {
  font-size: 36px;
  line-height: 48px;
  font-weight: 500;
  margin: 0;
  color: #FFFFFF;
}
.frontcover_booktitlealt {
  font-size: 16px;
  line-height: 24px;
  font-weight: 400;
  margin: 16px 0 0 0;
  color: #FFFFFF;
}
.frontcover_cover_image {
  width: 794px;
  height: 650px;
  object-fit: fill;
}
.frontcover_footer {
  display: none;
}