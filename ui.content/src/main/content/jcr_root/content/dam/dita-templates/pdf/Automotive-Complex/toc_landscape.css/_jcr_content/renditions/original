#landscape_complex div.topic-body {
  display: flex;
  column-gap: unset;
}
.toc_header_landscape {
  transform: translateX(51%);
  padding-top: 30px;
  margin-bottom: 41px;
}
.toc-body {
  padding-top: 30px;
  padding-left: 30px;
}
.toc-img,
.toc-img_left,
.toc-img_right {
  height: 590px;
  width: 470px;
  /* background-image: url('../../../aemguidesDALP/automotives/images/toc_landscape.png'); */
  /* background-size: 100% 100%; */
}
#toc_firstpage_header_title {
  font-size: var(--text-lg);
  font-weight: 400;
  color: var(--color-primary);
  line-height: var(--text-lg-lh);
  margin-bottom: 8px;
  font-family: var(--font-fam-primary);
}
#toc_firstpage_header_titlealts {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  margin-bottom: 35px;
  padding-bottom: 35px;
  font-family: var(--font-fam-secondary);
}
#toc_firstpage_header_mainbooktitle {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-primary);
  line-height: var(--text-xs-lh);
}
#toc_firstpage_header_page-number {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-primary);
  line-height: var(--text-sm-lh);
  letter-spacing: -4%;
  text-align: var(--page-number-text-align);
}
#toc_firstpage_footer_title {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_mainbooktitle {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_product-name {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_copyright {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_product-brand {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_page-number {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-sm-lh);
  letter-spacing: var(--footerletter-spacing);
  text-align: var(--page-number-text-align);
}
#toc_firstpage_footer_urls {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
  text-decoration: underline;
  text-decoration-style: solid;
  text-decoration-skip-ink: false;
}
#toc_firstpage_footer_version {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_email {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-neutral);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_organization {
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#landscape_complex .toc-title {
  color: var(--color-primary);
  font-size: var(--text-xl);
  font-weight: 400;
  line-height: var(--text-xl-lh);
  text-align: left;
}
#landscape_complex .toc-sub_title {
  color: var(--color-tertiary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
}
#landscape_complex .toc-level-1 {
  font-size: var(--text-xs);
  font-weight: 700;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-decoration-skip-ink: none;
  color: var(--color-secondary);
  /* border-top: 1px solid var(--color-tertiary); */
  padding-top: 15px;
  margin-bottom: 8px;
  font-family: var(--font-fam-secondary);
  text-transform: uppercase;
}
#landscape_complex .toc-level-2 {
  color: var(--color-tertiary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-decoration-skip-ink: none;
  margin-bottom: 8px;
  font-family: var(--font-fam-secondary);
}
#landscape_complex .toc-level-3 {
  color: var(--color-tertiary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-decoration-skip-ink: none;
  margin-bottom: 8px;
  font-family: var(--font-fam-secondary);
}
#landscape_complex .pdf-toc-level-1:after {
  content: " ";
}
#landscape_complex .pdf-toc-level-2:after {
  color: var(--color-accent);
  font-weight: 700;
}
#landscape_complex .toc-level-1:first-child {
  border-top: unset;
}
.toc-level-2 {
  margin-top: 15px;
  text-indent: -28px;
  margin-inline-start: 80px;
}
.toc_footer_hr {
  border: 0.5px solid #2C343B;
  margin: 0;
  padding: 0;
}
.toc_product_name {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-3xs-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  padding-top: 8px;
  margin: unset;
}
.toc-level-1 {
  text-indent: -24px;
  margin-inline-start: 47px;
}
.toc-level-1::before {
  margin-right: 15px;
}
.toc-level-2::before {
  margin-right: 10px;
}