/* Glossary Header Styles */
.glossary_firstpage_header {
  margin-bottom: 27px;
  text-align: left;
}
#glossary_header_title,
.glo-title {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xl);
  line-height: var(--text-xl-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 8px;
}
#glossary_header_titlealts,
.glossary_header_titlealts {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  margin-bottom: 0px;
  margin-top: 0px;
}
/* Glossary Term and Definition Styles */
.glo-term,
glossterm {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 700;
  color: var(--color-primary);
}
.glo-definition,
glossdef {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xxs);
  line-height: var(--text-xxs-lh);
  font-weight: 350;
  color: var(--color-tertiary);
}
/* Glossary Footer Styles */
/* .glossary_footer {
  margin-bottom: 40px;
} */
.glossary_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  padding-top: 8px;
  margin: unset;
}
.glossary_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-link);
  margin: unset;
}
.glossary_footer_hr {
  border: 0.5px solid #2C343B;
  margin: 0;
  padding: 0;
}
.glo-body {
  display: grid;
  grid-template-columns: auto auto;
  grid-column-gap: 84px;
  grid-row-gap: 16px;
  margin-top: 40px;
}
.rh-glossary-page-wrapper {
  display: flex;
}