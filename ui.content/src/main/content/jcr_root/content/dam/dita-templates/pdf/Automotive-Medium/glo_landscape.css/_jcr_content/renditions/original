/*Created with AEM Guides*/
#glossary_header {
  margin-bottom: 0px;
  text-align: left;
}
#glossary_header_title {
  font-family: var(--font-fam-secondary);
  font-size: 1.3rem;
  line-height: 1.3rem;
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 8px;
}
#glossary_header_titlealts {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  margin-bottom: 40px;
  margin-top: 0px;
}
#glossary_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin: 0;
  padding-top: 8px;
}
#glossary_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-link);
  text-decoration: none;
}
#glossary-footer {
  display: flex;
  flex-direction: column;
  align-items: baseline;
  row-gap: 1px;
  border-top: 0.5px solid #2C343B;
  justify-content: flex-start;
  padding-bottom: 108px;
  color: var(--color-tertiary);
}
.glo-term {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 700;
  color: var(--color-secondary);
}
.glo-definition {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 350;
  color: var(--color-tertiary);
}
glossterm {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 700;
  color: var(--color-secondary);
}
.glo-body {
  display: grid;
  grid-template-columns: auto auto;
  grid-column-gap: 248px;
  grid-row-gap: 16px;
  margin-top: 30px;
}