/*  ***** */
b,
.b {
  font-family: var(--font-fam-primary);
  line-height: var(--text-base-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  font-weight: bold;
  color: inherit;
  text-transform: uppercase;
  font-size: var(--text-base, 1rem);
  letter-spacing: 0px;
  undefined: undefined;
}
.restriction,
.note.caution,
.tip {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  padding: 8px 0px;
  border-top: 0.5px solid #D8D8D8;
  border-bottom: 0.5px solid #D8D8D8;
  border-left: unset;
  background-color: unset;
  margin: 45px 0px;
  font-size: 12px;
  font-family: var(--font-fam-primary);
}
.note.danger {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  padding: 8px 0px;
  border-top: 0.5px solid #D8D8D8;
  border-bottom: 0.5px solid #D8D8D8;
  border-left: unset;
  background-color: unset;
  margin: 20px 0px;
  font-size: 12px;
  font-family: var(--font-fam-primary);
}
.note.danger .prefix-content,
.restriction .prefix-content,
.note.caution .prefix-content,
.tip .prefix-content {
  font-weight: bold;
  display: flex;
  gap: 8px;
  align-items: center;
  justify-content: flex-start;
  font-size: 16px;
  font-family: var(--font-fam-primary);
  color: var(--color-primary);
}
.note.restriction .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/danger.png);
  background-size: 17px 17px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: var(--color-danger-light);
  border-radius: 60px;
  background-position: center;
}
.note.caution .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/caution.png);
  background-size: 17px 17px;
  background-repeat: no-repeat;
  width: 32px;
  height: 32px;
  display: block;
  background-color: var(--color-danger-light);
  border-radius: 60px;
  background-position: center;
}
.note.tip .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/tip.png);
  background-size: 13px 13px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: var(--color-danger-light);
  border-radius: 60px;
  background-position: center;
}
/* long message hazardement statement css */
.hazardstatement.warning,
.hazardstatement.danger,
.hazardstatement.notice,
.hazardstatement.caution {
  background-color: #FFFFFF;
  border: none;
  margin: 20px 0px;
}
.restriction.note.hazardstatement {
  display: block;
  border: none;
  background: none;
}
.danger.note.hazardstatement,
.caution.note.hazardstatement,
.warning.note.hazardstatement,
.notice.note.hazardstatement {
  display: block;
  border: unset;
  border-top: 0.5px solid #D8D8D8;
  border-bottom: 0.5px solid #D8D8D8;
  padding: 13px 0px;
  width: 100%;
}
.hazardstatement .prefix-content {
  background: none;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  padding: 8px 0px 8px 0px;
  border-top: unset;
  border-bottom: unset;
}
.note.danger .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/danger.png);
  background-size: 17px 17px;
  background-repeat: no-repeat;
  width: 32px;
  height: 32px;
  display: block;
  background-color: var(--color-danger-light);
  border-radius: 60px;
  background-position: center;
}
.note.danger.hazardstatement .prefix-content::before {
  border-radius: 10px;
}
.notice.hazardstatement .prefix-content::before {
  border-radius: 10px;
}
.warning.hazardstatement .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/restriction.png);
  background-size: 17px 17px;
  background-repeat: no-repeat;
  width: 32px;
  height: 32px;
  display: block;
  background-color: var(--color-danger-light);
  border-radius: 10px;
  background-position: center;
}
.caution.hazardstatement .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/caution.png);
  background-size: 17px 17px;
  background-repeat: no-repeat;
  width: 32px;
  height: 32px;
  display: block;
  background-color: var(--color-danger-light);
  border-radius: 10px;
  background-position: center;
}
.notice .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/fsi/images/common/notice.png);
  background-repeat: no-repeat;
  width: 32px;
  height: 32px;
  display: block;
  background-color: var(--color-danger-light);
  border-radius: 60%;
  background-position: center;
  background-size: 17px 17px;
}
.hazardstatement .messagepanel {
  list-style-type: disc;
  margin-top: 16px;
  margin-inline-start: 40px;
}
.hazardstatement .ul .li {
  background: white;
  padding: 0px;
  font-family: var(--font-fam-primary);
  font-weight: 400;
  font-style: normal;
  font-size: 12px;
  line-height: 12px;
  letter-spacing: 0px;
  color: var(--color-primary);
  list-style: disc;
  margin-bottom: unset;
  padding-bottom: 10px;
}
.hazardstatement .ul .li.tcx-empty-element {
  list-style: none;
}
.step div.itemgroup.info {
  background-color: unset;
  padding: 0px;
  border-left: unset;
  font-size: 14px;
  margin-top: 0px;
}
/*new elements  */
.overline {
  text-decoration: overline !important;
  color: var(--color-primary);
  /* Dark red color */
  font-weight: bold;
  border-top: 1px solid var(--color-primary);
}
/* Style for <line-through> */
.line-through {
  text-decoration: line-through;
  color: var(--color-primary);
  /* Gray color for strike-through text */
  font-style: italic;
}
/* Style for <xref> links */
.xref:hover {
  text-decoration: underline;
}
/* Style for <u> (underline) */
.u {
  text-decoration: underline;
  color: var(--color-primary, #0056b3);
  /* Green color for underline */
  font-weight: bold;
}
/* Style for <i> (italic) */
.i {
  font-style: italic;
  color: inherit;
  /* Blue color for italic text */
  font-size: inherit;
}
/* Style for <b> (bold) */
.b {
  font-weight: bold;
  color: inherit;
  font-size: inherit;
  /* Orange color for bold text */
}
/* Style for <tt> (monospace) */
.tt {
  font-family: var(--font-fam-primary);
  background-color: var(--color-primary-light);
  /* Light gray background */
  padding: 0.2em 0.4em;
  border-radius: 4px;
}
/* Style for <sup> (superscript) */
.sup {
  font-size: inherit;
  vertical-align: super;
  color: inherit;
  font-family: var(--font-fam-primary);
  font-weight: 600;
}
/* Style for <sub> (subscript) */
.sub {
  font-size: inherit;
  vertical-align: super;
  color: inherit;
  font-family: var(--font-fam-primary);
  font-weight: 600;
  /* Blue color for subscript */
}
/* General paragraph styles */
/* Optional hover effect for links */
a:hover {
  color: #D32F2F;
  /* Change color on hover */
}
/* simple dita element */
/* ****  */
.example p,
.example .p {
  font-size: var(--text-2xl);
  font-weight: 400;
  line-height: var(--text-2xl-lh);
  color: var(--color-secondary);
  margin-bottom: 0px;
  border-top: unset;
  border-left: 2px solid var(--color-tertiary);
  padding: 10px;
}
.example h1.chapter:before {
  content: " ";
}
.example .codeblock {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-lg);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: var(--color-tertiary);
  border: unset;
  background-color: var(--color-primary);
}
.example {
  display: block;
  background-color: var(--color-primary-light);
  border: unset;
  border-radius: 0px;
  padding: 20px;
  margin: 20px auto;
  width: 80%;
}
.lines {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  /* purple color */
  color: var(--color-primary);
  padding: 15px;
  max-width: 600px;
  text-align: center;
  letter-spacing: 1px;
  word-wrap: break-word;
  break-inside: avoid;
  font-family: var(--font-fam-primary);
}
.pre {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  background-color: var(--color-primary);
  padding: 16px;
  border-radius: 10px;
  border: 0.5px solid var(--color-border);
  /* box-shadow: 0px 4px 12px rgba(70, 130, 180, 0.2); */
  margin: 20px 0px;
  max-width: unset;
  word-wrap: break-word;
  white-space: pre-wrap;
  break-inside: avoid;
  font-family: monospace;
}
.pre .code {
  background-color: #e6e6e6;
  padding: 2px 4px;
  border-radius: 4px;
}
tm {
  font-weight: bold;
  color: #0056b3;
  background-color: #e0f7fa;
  padding: 2px 4px;
  border-radius: 4px;
  text-decoration: underline;
  box-shadow: 0px 2px 6px rgba(0, 86, 179, 0.3);
}
tm[tmtype="tm"] {
  font-style: italic;
  color: #ff5722;
  background-color: #ffe0b2;
}
tm[tmtype="reg"] {
  color: #4caf50;
  background-color: #e8f5e9;
}
tm[tmclass="ibm"] {
  font-weight: bold;
  color: #000000;
  background-color: #f1f1f1;
  border: 1px solid #cccccc;
}
.hazardstatement .prefix-content::before {
  width: 40px;
  height: 40px;
}
.hazardstatement.note.warning .prefix-content::before,
.hazardstatement.note.danger .prefix-content::before,
.hazardstatement.note.notice .prefix-content::before,
.caution.note.hazardstatement .prefix-content::before {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background-color: var(--color-blue);
}
.note.caution .prefix-content::before,
.note.tip .prefix-content::before,
.note.restriction .prefix-content::before,
.note.danger .prefix-content::before {
  width: 40px;
  height: 40px;
  background-color: var(--color-primary-light);
  border-radius: 10px;
}
.lof_footer_urls,
#index_footer_urls,
.lot_footer_urls,
.glossary_footer_urls {
  color: var(--color-accent) !important;
  text-decoration: underline !important;
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-lg);
  /* text-align: left; */
}
.idx-keyword-group{
  display: none;
}