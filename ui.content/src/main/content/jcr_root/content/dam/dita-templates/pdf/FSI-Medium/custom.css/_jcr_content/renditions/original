/* Container for steps */
ol.steps {
  /* Limit the width */
  /* Center it */
  /* Initialize the counter */
  list-style: none;
  padding: 0;
  margin: 0;
  position: relative;
  max-width: 600px;
  margin: 30px auto;
  font-family: var(--font-fam-primary);
  counter-reset: step-counter;
}
/* Each step */
li.step {
  position: relative;
  padding-left: 50px;
  /* Space for the vertical line and step icon */
  margin-bottom: 40px;
  /* Vertical spacing between steps */
  transition: transform 0.3s ease;
  font-size: var(--text-lg);
  line-height: var(--text-lg-lh);
  font-weight: 400;
  font-family: var(--font-fam-primary);
  color: var(--color-primary);
}
/* Vertical line connecting steps */
ol.steps::before {
  /* Position the line in the center */
  content: '';
  position: absolute;
  top: 0;
  left: 25px;
  width: 2px;
  height: 100%;
  background-color: var(--color-bg-light, #e0e0e0);
  z-index: 1;
}
/* Circle steps with numbers */
li.step::before {
  content: counter(step-counter);
  counter-increment: step-counter;
  position: absolute;
  left: 8px;
  top: 14px;
  transform: translateY(-50%);
  width: 30px;
  height: 30px;
  background: var(--color-primary, green);
  color: var(--color-tertiary);
  font-weight: bold;
  font-size: 16px;
  border-radius: 50%;
  border: none;
  text-align: center;
  line-height: 24px;
  z-index: 2;
}
/* Active step */
li.step.active::before {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
/* Completed step */
li.step.completed::before {
  background-color: var(--color-accent);
  /* Green for completed step */
  border-color: var(--color-accent);
  /* Border color for completed */
}
