/*Created with AEM Guides*/
.toc-config {
  --toc-gap: 20px;
  --toc-level-2-gap: calc(var(--toc-gap) * 1);
  --toc-level-3-gap: calc(var(--toc-gap) * 2);
}
#toc_firstpage_header_title {
  font-family: var(--font-fam-secondary);
  font-size: 1.125rem;
  font-weight: 400;
  color: var(--color-primary);
  line-height: var(--text-lg-lh);
  letter-spacing: -4%;
}
#toc_firstpage_header_titlealts {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  letter-spacing: -4%;
}
#toc_firstpage_header_mainbooktitle {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--title-color);
  line-height: var(--text-xs-lh);
  letter-spacing: -4%;
}
#toc_firstpage_header_page-number {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-primary);
  line-height: var(--text-xs-lh);
  letter-spacing: -4%;
  text-align: var(--page-number-text-align);
}
#toc_firstpage_footer_title {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-tertiary);
  line-height: var(--text-xs-lh);
  color: var(--footer-text-primary-color);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_mainbooktitle {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_copyright {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_product-brand {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_page-number {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
  text-align: var(--page-number-text-align);
}
#toc_firstpage_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--url-color);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
  text-decoration: underline;
  text-decoration-style: solid;
  text-decoration-skip-ink: false;
}
#toc_firstpage_footer_version {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_email {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_organization {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: var(--text-xs-lh);
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage .toc-title {
  font-family: var(--font-fam-secondary);
  color: var(--color-primary);
  font-size: var(--text-xl);
  font-weight: 400;
  line-height: var(--text-xl-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  margin-bottom: 3px;
}
#toc_firstpage .toc-sub_title {
  font-family: var(--font-fam-primay);
  color: var(--color-tertiary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  margin-bottom: 24px;
  margin-top: 0;
}
#toc_firstpage .toc-level-1 {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 700;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-decoration-skip-ink: none;
  color: var(--color-secondary);
  padding-top: 40px;
  margin-bottom: 5px;
  border: unset;
  padding-bottom: 8px;
}
#toc_firstpage .toc-level-2 {
  font-family: var(--font-fam-secondary);
  color: var(--color-tertiary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-decoration-skip-ink: none;
  margin-bottom: 2px;
  /* text-indent: 20px; */
  padding-bottom: 8px;
  padding-left: 0px;
}
#toc_firstpage .toc-level-3,
#toc_firstpage .toc-level-4 {
  font-family: var(--font-fam-secondary);
  color: var(--color-tertiary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-decoration-skip-ink: none;
  margin-bottom: 2px;
  padding-bottom: 8px;
}
#toc_firstpage .toc-level-3 {
  text-indent: 0px;
  padding-left: 40px;
}
#toc_firstpage .toc-level-4 {
  text-indent: 60px;
}
#toc_firstpage .pdf-toc-level-1:after {
  color: var(--color-accent);
  padding-right: 20px;
}
#toc_firstpage .pdf-toc-level-2:after,
#toc_firstpage .pdf-toc-level-3:after,
#toc_firstpage .pdf-toc-level-4:after {
  color: var(--color-accent);
  padding-right: 0px;
}
#toc_firstpage .toc-body {
  column-count: 2;
  column-gap: 136px;
}
.toc-level-1 {
  text-indent: -30px;
  /* margin-inline-start: 45px; */
}
.toc-level-1::before {
  margin-right: 15px;
}
.toc-level-2::before {
  margin-right: 10px;
}
.toc-level-2 {
  text-indent: -28px;
  margin-inline-start: 35px;
}