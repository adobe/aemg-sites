/*Created with AEM Guides*/
.backcover-details {
  display: flex;
  flex-direction: column;
  gap: 63px;
  position: fixed;
  bottom: 0;
  right: 7px;
  width: 295px;
}
.backcover_organization-details {
  display: flex;
  flex-direction: column;
  gap: 40px;
}
.backcover_org-contact-label,
.backcover_org-address-label,
.backcover_org-socials-label {
  font-family: Inter;
  font-size: var(--text-xs);
  font-weight: 700;
  line-height: var(--text-xs-lh);
  letter-spacing: 1px;
  text-align: left;
  color: var(--color-accent);
  margin: 0px;
}
.backcover_contact-container,
.backcover_address-container,
.backcover_socials-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.backcover_org-contactnumbers,
.backcover_org-emailaddresses,
.backcover_org-addressdetails a,
.backcover_org-socials a {
  font-family: Inter;
  font-size: var(--text-4xs);
  font-weight: 400;
  line-height: var(--text-4xs-lh);
  text-align: left;
  color: var(--color-accent);
  margin: 0;
  text-decoration: none;
  align-content: end;
}
.backcover_org-contactnumbers,
.backcover_org-emailaddresses,
.backcover_org-addressdetails,
.backcover_org-socials {
  display: flex;
  flex-wrap: wrap;
}
.backcover_org-addressdetails {
  width: 133px;
}
.main-description {
  font-family: Urbanist;
  font-size: var(--text-2xl);
  font-weight: 500;
  line-height: var(--text-2xl-lh);
  text-align: left;
  color: var(--color-accent);
  margin: 0;
}
.img-icon {
  height: 16px;
  width: 16px;
  margin-right: 8px;
  margin-bottom: -2px;
}
.email-icon {
  height: 10.68px;
  width: 16px;
}
