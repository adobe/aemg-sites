/*Created with AEM Guides*/
.backcover-details {
  display: flex;
  flex-direction: column;
  gap: 63px;
  position: fixed;
  bottom: 0;
  right: 7px;
  width: 295px;
}
.backcover_organization-details {
  display: flex;
  flex-direction: column;
  gap: 40px;
}
.backcover_org-contact-label a,
.backcover_org-address-label a,
.backcover_org-socials-label a{
  font-family: Inter;
  font-size: var(--text-xs);
  font-weight: 700;
  line-height: var(--text-xs-lh);
  letter-spacing: 1px;
  text-align: left;
  color: var(--color-accent);
  margin: 0;
  text-decoration: none;
}
.backcover_contact-container,
.backcover_address-container,
.backcover_socials-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.backcover_org-contactnumbers,
.backcover_org-emailaddresses,
.backcover_org-addressdetails,
.backcover_org-socials {
  font-family: Inter;
  font-size: var(--text-4xs);
  font-weight: 400;
  line-height: var(--text-4xs-lh);
  text-align: left;
  color: var(--color-accent);
  margin: 0;
}
.main-description {
  font-family: Urbanist;
  font-size: var(--text-2xl);
  font-weight: 500;
  line-height: var(--text-2xl-lh);
  text-align: left;
  color: var(--color-accent);
  margin: 0;
}
.img-icon {
  height: 16px;
  width: 16px;
  margin-right: 8px;
}
.email-icon {
  height: 10.68px;
  width: 16px;
}