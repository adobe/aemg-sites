.backcover_landsc_header {
  padding-top: 69px;
  padding-left: 74px;
}
.backcover_landsc_logo {
  width: 144px;
  height: 106px;
}
.backcover_landsc_text {
  margin-bottom: 44px;
}
.backcover_landsc_description {
  font-size: 24px;
  line-height: 32px;
  font-weight: 500;
  color: #0C1256;
  margin: 0;
}
.backcover_landsc_content {
  width: 468px;
  position: absolute;
  bottom: 46px;
  right: 80px;
}
.backcover_landsc_contact_label {
  font-size: 12px;
  line-height: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #0C1256;
  padding-bottom: 10px;
  margin: 0;
  text-transform: uppercase;
}
.backcover_landsc_address_label {
  font-size: 12px;
  line-height: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #0C1256;
  padding-bottom: 10px;
  margin: 0;
  text-transform: uppercase;
}
.backcover_landsc_socials_label {
  font-size: 12px;
  line-height: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #0C1256;
  padding-bottom: 10px;
  margin: 0;
  text-transform: uppercase;
}
.backcover_landsc_phoneno_container,
.backcover_landsc_email_container,
.backcover_landsc_socials_link_container {
  display: flex;
  align-items: center;
  gap: 8px;
}
.backcover_landsc_phoneno_container {
  padding-bottom: 10px;
}
.backcover_landsc_phone_number,
.backcover_landsc_email,
.backcover_landsc_address,
.backcover_landsc_social {
  font-size: 9px;
  line-height: 12px;
  font-weight: 400;
  color: #0C1256;
  margin: 0;
}
.backcover_landsc_phone_img {
  width: 16px;
  height: 16px;
}
.backcover_landsc_email_img {
  width: 16px;
  height: 10.89px;
}
.backcover_landsc_insta_img {
  width: 16px;
  height: 16px;
}
.backcover_landsc_contact_container,
.backcover_landsc_address_container {
  margin-bottom: 40px;
}