/*Created with AEM Guides*/
@font-face {
  font-family: PP Editorial New;
  src: url('../../../aemguidesDALP/fonts/pp-editorial-new/PPEditorialNew-Regular.otf');
}
@font-face {
  font-family: Adobe Clean;
  src: url('../../../aemguidesDALP/fonts/adobe-clean/AdobeClean-Regular.woff');
}
@font-face {
  font-family: Inter;
  src: url('../../../aemguidesDALP/fonts/inter/Inter-Light.woff');
  font-weight: 300;
}
@font-face {
  font-family: Inter;
  src: url('../../../aemguidesDALP/fonts/inter/Inter-Regular.woff');
  font-weight: 400;
}
@font-face {
  font-family: Inter;
  src: url('../../../aemguidesDALP/fonts/inter/Inter-Medium.woff');
  font-weight: 500;
}
@font-face {
  font-family: Inter;
  src: url('../../../aemguidesDALP/fonts/inter/Inter-Bold.woff');
  font-weight: 700;
}
@font-face {
  font-family: Urbanist;
  src: url('../../../aemguidesDALP/fonts/urbanist/Urbanist-Medium.ttf');
  font-weight: 500;
}
html {
  font-size: var(--base-font-size);
}
body {
  font-family: var(--font-fam-primary-light);
}
.global-config,
:root {
  /* font family */
  --font-fam-primary-light: "Inter", sans-serif;
  --font-fam-primary-regular: "Inter", sans-serif;
  --font-fam-primary-medium: "Inter", sans-serif;
  --font-fam-primary-bold: "Inter", sans-serif;
  --font-fam-secondry: "Urbanist", serif;
}
.color-config,
:root {
  --color-accent: #0C1256;
  --color-primary: #013220;
  --color-primary-white: #FFFFFF;
  --color-primary-light: #E2F8F0;
  --color-secondary: #2C343B;
  --color-tertiary: #FDA14A;
  --color-neutral: #D8D8D8;
  --color-dark: #002417;
  --color-black: #222222;
  --color-blue: #C6DFD9;
  --color-gray: #AEAEAE;
  --color-green: #02403D;
  --color-neutral-light: #EEEEEE;
  --color-dark-grey: #2C3E50;
  --color-bg-light: #E0E0E0;
  --color-lighter-bg: #ccc;
  --color-white-light: #F3F3F3;
  --color-grey-lighter: #F4F4F4;
  --color-black-grey: #333;
  --color-danger-light: #FFF0F0;
  --color-danger-dark: #FFD7D6;
  --color-tip-light: #EEEEEE;
  --color-tip-dark: #ddd;
  --color-caution-light: #FFF9E5;
  --color-caution-dark: #F5C823;
  --color-restriction-light: #EEEEEE;
  --color-restriction-dark: #ddd;
  --color-warning-light: #FFEDDF;
  --color-warning-dark: #FFB47B;
  --color-notice-light: #F6F9FC;
  --color-notice-dark: #E4EDF6;
  --color-danger-darker: #FF0000;
  --color-footnote-light: #F8F9FA;
  --color-bg-light-secondary: #E8F1FF;
  --color-xref-primary: #0074D9;
}
.toc-config,
:root {
  --toc-gap: 20px;
  --toc-level-1-gap: calc(var(--toc-gap) * 0);
  --toc-level-2-gap: calc(var(--toc-gap) * 0);
  --toc-level-3-gap: calc(var(--toc-gap) * 1);
  --toc-level-4-gap: calc(var(--toc-gap) * 2);
}
footer {
  color: rgba(44, 52, 59, 0.7);
}
.typography-config,
:root {
  /* converted form 16px base size*/
  --text-4xs: 0.563rem;
  /* 9px */
  --text-3xs: 0.625rem;
  /* 10px */
  --text-2xs: 0.688rem;
  /* 11px */
  --text-4xs-lh: 0.75rem;
  /* 12px */
  --text-xs: 0.75rem;
  /* 12px */
  --text-xs-lh: 1rem;
  /* 16px */
  --text-sm: 0.875rem;
  /* 14px */
  --text-2xs-lh: 0.875rem;
  /* 14px */
  --text-sm-lh: 1.25rem;
  /* 20px */
  --text-base: 1rem;
  /* 16px */
  --text-base-lh: 1.5rem;
  /* 24px */
  --text-lg: 1.125rem;
  /* 18px */
  --text-lg-lh: 1.5rem;
  /* 24px */
  --text-xl: 1.25rem;
  /* 20px */
  --text-xl-lh: 1.75rem;
  /* 28px */
  --text-2xl: 1.5rem;
  /* 24px */
  --text-2xl-lh: 2rem;
  /* 32px */
  --text-3xl: 1.875rem;
  /* 30px */
  --text-3xl-lh: 2.5rem;
  /* 40px */
  --text-4xl: 2.25rem;
  /* 36px */
  --text-4xl-lh: 3rem;
  /* 48px */
  --text-5xl: 3rem;
  /* 48px */
  --text-5xl-lh: 3.875rem;
  /* 62px */
  --text-6xl: 3.75rem;
  /* 60px */
  --text-6xl-lh: 4.75rem;
  /* 76px */
  --text-7xl: 4.5rem;
  /* 72px */
  --text-7xl-lh: 5.625rem;
  /* 90px */
  --text-8xl: 6rem;
  /* 96px */
  --text-8xl-lh: 7.75rem;
  /* 124px */
  --text-9xl: 8rem;
  /* 128px */
  --text-9xl-lh: 9.625rem;
  /* 154px */
}
/* Text size classes */
.p.text-xs,
.text-xs {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
}
.p.text-sm,
.text-sm {
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
}
.p.text-base,
.text-base {
  font-size: var(--text-base);
  line-height: var(--text-xl);
}
.p.text-lg,
.text-lg {
