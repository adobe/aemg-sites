/*Created with AEM Guides*/
@font-face {
  font-family: PP Editorial New;
  src: url('../../../aemguidesDALP/fonts/pp-editorial-new/PPEditorialNew-Regular.otf');
}
@font-face {
  font-family: Adobe Clean;
  src: url('../../../aemguidesDALP/fonts/adobe-clean/AdobeClean-Regular.woff');
}
body {
  font-family: var(--font-fam-secondary);
}
.global-config,
:root {
  /* font family */
  --font-fam-primary: PP Editorial New;
  --font-fam-secondary: Adobe Clean;
  --base-font-size: 16px;
}

html {
  font-size: var(--base-font-size);
}

.color-config,
:root {
  --color-accent: #821616;
  --color-primary: #001E3A;
  --color-secondary: #0D0D0D;
  --color-tertiary: #2C343B;
  --color-neutral: #979797;
  --color-link: #0F85EC;
  --color-tertiary-opa-50: rgba(235, 95, 95, 0.6);
  --color-tertiary-opa-70: rgba(44, 52, 59, 0.7);
  --frontcover-text-color: #FFFFFF;
  --frontcover-right-bg: #000000;
  --frontcover-landsc-bg: #006d9c;
  --frontcover-landsc-bg-blur: #02719F;

}
.toc-config,
:root {
  --toc-gap: 20px;
  --toc-level-1-gap: calc(var(--toc-gap) * 0);
  --toc-level-2-gap: calc(var(--toc-gap) * 0);
  --toc-level-3-gap: calc(var(--toc-gap) * 1);
  --toc-level-4-gap: calc(var(--toc-gap) * 2);
}
footer {
  color: rgba(44, 52, 59, 0.7);
}
.typography-config,
:root {
  /* converted form 16px base size*/
  --text-4xs: 0.563rem; /* 9px */
  --text-4xs-lh: 0.75rem; /* 12px */
  
  --text-3xs: 0.625rem; /* 10px */
  --text-3xs-lh: 0.75rem; /* 12px */
  
  --text-2xs: 0.688rem; /* 11px */
  --text-2xs-lh: 0.875rem; /* 14px */
  --text-xs: 0.75rem;
  /* 12px */
  --text-xs-lh: 1rem;
  /* 16px */
  --text-sm: 0.875rem;
  /* 14px */
  --text-sm-lh: 1.25rem;
  /* 20px */
  --text-base: 1rem;
  /* 16px */
  --text-base-lh: 1.5rem;
  /* 24px */
  --text-lg: 1.125rem;
  /* 18px */
  --text-lg-lh: 1.5rem;
  /* 24px */
  --text-xl: 1.25rem;
  /* 20px */
  --text-xl-lh: 1.75rem;
  /* 28px */
  --text-2xl: 1.5rem;
  /* 24px */
  --text-2xl-lh: 2rem;
  /* 32px */
  --text-3xl: 1.875rem;
  /* 30px */
  --text-3xl-lh: 2.5rem;
  /* 40px */
  --text-4xl: 2.25rem;
  /* 36px */
  --text-4xl-lh: 3rem;
  /* 48px */
  --text-5xl: 3rem;
  /* 48px */
  --text-5xl-lh: 3.875rem;
  /* 62px */
  --text-6xl: 3.75rem;
  /* 60px */
  --text-6xl-lh: 4.75rem;
  /* 76px */
  --text-7xl: 4.5rem;
  /* 72px */
  --text-7xl-lh: 5.625rem;
  /* 90px */
  --text-8xl: 6rem;
  /* 96px */
  --text-8xl-lh: 7.75rem;
  /* 124px */
  --text-9xl: 8rem;
  /* 128px */
  --text-9xl-lh: 9.625rem;
  /* 154px */
}
/* Text size classes */
.p.text-xs,
.text-xs {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
}
.p.text-sm,
.text-sm {
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
}
.p.text-base,
.text-base {
  font-size: var(--text-base);
  line-height: var(--text-xl);
}
.p.text-lg,
.text-lg {
