  box-sizing: border-box;
  transform: translate(71px, 0px);
}
.fig,
fig .content-figure-image {
  margin-left: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-top: 0;
  background-color: unset;
  box-shadow: unset;
  padding: 0;
  max-width: unset;
  display: unset;
}
@media (orientation: portrait) {
  /* content css start from here  */
  .content-figure-image .title,
  figcaption.title>.prefix-content::after {
    font-family: Adobe Clean;
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 12px;
    text-align: left;
    color: var(--color-secondary);
    margin-bottom: 8px;
  }
  .Images-content-section-container {
    display: flex;
    gap: 40px;
    flex-direction: column;
  }
  .images-main-container {
    display: flex;
    gap: 9px;
    width: 648px;
  }
  .image-num-container {
    background: #F2F2F2;
    height: 300px;
    width: 210px;
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    box-sizing: border-box;
  }
  .image-num-container .number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #0C1256;
    color: var(--color-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Inter;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0px;
  }
  .content-section {
    margin-top: 0px;
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 20px;
    text-align: left;
    color: var(--color-accent);
    text-align: left;
    column-count: 2;
    column-gap: 80px;
    padding-left: unset;
  }
  .content-section .p {
    column-count: unset;
    column-gap: unset;
  }
  .note-cont .note {
    background: none;
    font-family: Urbanist;
    font-size: 9px;
    font-style: italic;
    font-weight: 400;
    line-height: 11px;
    text-align: left;
    padding: 0px;
    margin: 0px;
    border-left: none;
  }
  .note-cont img {
    width: 74%;
    height: 74%;
  }
  .note-cont .note:before {
    width: 0px;
  }
  .note-cont .placement-inline {
    display: inline;
    width: 17%;
    height: 100%;
  }
  .note-cont {
    display: flex;
    align-items: center;
    border-top: 0.5px solid #D8D8D8;
    border-bottom: 0.5px solid #D8D8D8;
    padding: 9px -0px;
    gap: 8px;
  }
  .thead {
    background: #E8F1FF;
    color: var(--color-accent);
    font-weight: 500;
    font-size: 14px;
  }
}
.col-2 {
  column-count: 2;
  gap: 40px;
}
.col-3 {
  column-count: 3;
  gap: unset;
}
.col-4 {
  column-count: unset;
  gap: unset;
}
.col-5 {
  column-count: unset;
  gap: unset;
}