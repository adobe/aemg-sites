#toc_firstpage .toc-title {
  font-family: var(--font-fam-secondary);
  color: var(--color-primary);
  font-size: var(--text-xl);
  font-weight: 400;
  line-height: var(--text-xl-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  margin-bottom: 8px;
}
#toc_firstpage .toc-sub_title {
  font-family: var(--font-fam-primary);
  color: var(--color-tertiary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  margin-bottom: 48px;
}
#toc_firstpage .toc-level-1 {
  text-transform: uppercase;
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  font-weight: 700;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-decoration-skip-ink: none;
  color: var(--color-secondary);
  padding-top: 32px;
  margin-bottom: 5px;
  border: unset;
  padding-bottom: 4px;
  word-break: break-word;
  word-wrap: break-word;
  overflow-wrap: break-word;
  white-space: normal;
  letter-spacing: 0.5px;
}
#toc_firstpage .toc-level-1:nth-child(1) {
  padding-top: 0px;
}
#toc_firstpage .toc-level-2 {
  font-family: var(--font-fam-secondary);
  color: var(--color-tertiary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-sm-lh);
  text-align: left;
  text-decoration-skip-ink: none;
  margin-bottom: 2px;
  padding-left: var(--toc-level-2-gap);
  padding-bottom: 2px;
  margin-inline-start: 30px;
  text-indent: -1px;
  word-break: break-word;
  /* display: flex;
  justify-content: space-between;
  align-items: flex-end; */
  /* text-indent: -7px; */
  /* position: relative; */
}
#toc_firstpage .toc-level-3 {
  font-family: var(--font-fam-secondary);
  padding-left: var(--toc-level-3-gap);
  color: var(--color-tertiary);
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  text-align: left;
  text-decoration-skip-ink: none;
  margin-bottom: 2px;
  padding-bottom: 2px;
}
#toc_firstpage .pdf-toc-level-1::after {
  color: var(--color-accent);
  content: "";
  /* margin-left: 10%;   */
}
.toc-level-2::after,
.toc-level-3::after {
  color: var(--color-accent);
  content: "mycontent";
  /* margin-inline-start: 30px; */
  /* margin-left: 10%;   */
}
#toc_firstpage .toc-level-2::first-line {
  text-decoration: underline;
  /* margin-right: 30px; */
}
#toc_firstpage .toc-level-3::first-line {
  text-decoration: underline;
  /* margin-right: 30px; */
}
#toc_firstpage .toc-body {
  column-count: 2;
  column-gap: 60px;
}
.toc_footer {
  border-top: 0.5px solid var(--color-tertiary-opa-70);
  color: var(--color-tertiary-opa-70);
}
.toc-level-1,
.toc-level-2,
.toc-level-3,
.toc-level-4,
.toc-level-5,
.toc-level-6 {
  text-indent: 0px;
  word-break: break-word;
  box-sizing: border-box;
}
