.backcover {
  display: flex;
  flex-direction: column;
  padding-top: 80px;
  padding-right: 73px;
  padding-bottom: 40px;
  padding-left: 73px;
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
.backcover_header {}
.backcover_title {
  display: flex;
  flex-direction: column;
  font-family: var(--font-fam-primary);
  color: var(--color-primary);
  font-size: var(--text-5xl);
  font-weight: 400;
  line-height: var(--text-5xl-lh);
  margin-bottom: 8px;
}
/* backcover_header-text */
.backcover_header-text {
  font-size: var(--text-base);
  font-weight: 400;
  line-height: var(--text-base-lh);
}
/* backcover_desciption */
.backcover_desciption {
  margin-top: auto;
  width: 304px;
  font-size: var(--text-xs);
  font-weight: 350;
  line-height: var(--text-xs-lh);
  color: var(--color-secondary);
}
/* backcover_organization-details */
.backcover_organization-details {
  display: flex;
  column-gap: 40px;
  justify-content: space-between;
  margin-top: 48px;
}
/* backcover_contact-container */
.backcover_contact-container {
  width: 33%;
}
.backcover_address-container {
  width: 33%;
}
.backcover_socials-container {
  max-width: 33%;
  /* width: fit-content;
  margin-left: auto; */
  white-space: nowrap;
}
.backcover_contact-container,
.backcover_address-container,
.backcover_socials-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
/* backcover_org-contact-label */
.backcover_org-contact-label,
.backcover_org-address-label,
.backcover_org-socials-label {
  font-size: var(--text-xs);
  font-weight: 700;
  line-height: var(--text-xs-lh);
  color: var(--color-accent);
}
/* backcover_org-contactnumbers */
.backcover_org-contactnumbers,
.backcover_org-emailaddresses,
.backcover_org-addressdetails,
.backcover_org-socials {
  display: flex;
  align-items: center;
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  color: var(--color-primary);
}
/* backcover_footer */
.backcover_footer {
  margin-top: 40px;
  padding-top: 8px;
  border-top: 0.5px solid #2C343B;
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  opacity: 0.7;
  color: var(--color-tertiary);
}
.backcover_created-date {
  /* Empty class, no styles to add */
}
.backcover_isbn {
  /* Empty class, no styles to add */
}
.backcover_booknumber {
  /* Empty class, no styles to add */
}
.backcover_bookseries {
  /* Empty class, no styles to add */
}
.img-icon {
  margin-right: 8px;
  max-width: 13px;
  max-height: 13px;
}