/*Created with AEM Guides*/
.backcover-details-landscape {
  display: flex;
  flex-direction: column;
  position: fixed;
  bottom: 0px;
  right: 7px;
  gap: 63px;
  margin-right: 80px;
  margin-bottom: 0px;
  /* width: 468px; */
}
.backcover_organization-details {
  display: flex;
  flex-direction: column;
  gap: 40px;
}
.backcover_org-contact-label,
.backcover_org-address-label,
.backcover_org-socials-label {
  font-family: Adobe Clean;
  font-size: 12px;
  font-weight: 700;
  line-height: 14px;
  text-align: left;
  color: #000000;
  margin: 0;
}
.backcover_contact-container,
.backcover_address-container,
.backcover_socials-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.backcover_org-contactnumbers,
.backcover_org-emailaddresses,
.backcover_org-addressdetails,
.backcover_org-socials {
  font-family: Adobe Clean;
  font-size: 12px;
  font-weight: 400;
  line-height: 14px;
  text-align: left;
  color: #000000;
  margin: 0;
}
.main-description {
  font-family: Urbanist;
  font-size: 28px;
  font-weight: 500;
  line-height: 34px;
  text-align: left;
  color: #010101;
  margin: 0;
}
.img-icon {
  height: 16px;
  width: 16px;
  margin-right: 8px;
}
.email-icon-land {
  height: 10.68px;
  width: 16px;
}