/* Created with AEM Guides */
#index-header {
  margin-bottom: 27px;
  text-align: left;
}
#index_header_title {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xl);
  line-height: var(--text-xl-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 8px;
}
#index_header_titlealts {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  margin-bottom: 40px;
  padding-bottom: 40px;
}
.idx-body {
  column-count: unset;
  column-fill: unset;
}
.idx-title {
  column-span: all;
}
.idx-keyword-group {
  font-weight: bold;
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  margin-top: 16pt;
}
.idx-keyword-group:first-of-type {
  margin-top: 0;
}
.idx-unit {
  /* padding-bottom: 16px; */
}
.idx-keyword {
  margin: unset;
}
.idx-name {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 350;
  color: var(--color-primary);
  margin-bottom: 16px;
}
.idx-link {
  text-decoration: none;
}
.idx-child {
  /* display: flex;
  justify-content: space-between;
  flex-wrap: wrap; */
  column-gap: 150px;
  margin-top: 40px;
  padding-left: 0px;
  column-count: 2;
}
/* #index_footer {
  border-top: 0.5px solid #2C343B;
} */
#index_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  padding-top: 8px;
  margin: 0;
}
#index_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-link);
}
a.book-idx-link.idx-link {
  color: var(--color-accent);
}
#index_footer {
  display: flex;
  flex-direction: column;
  align-items: baseline;
  row-gap: 1px;
  border-top: 0.5px solid #2C343B;
  color: var(--color-tertiary);
  justify-content: flex-start;
}
.rh-index-page-wrapper{
    column-count: 2;
}