.lot_header {
  margin-top: 50px;
  text-align: left;
}
.lot_header_title {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  font-weight: 400;
  color: var(--color-primary);
  margin-bottom: 8px;
}
.lot_header_titlealts {
  font-family: var(--font-fam-primary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-tertiary);
  margin-bottom: 40px;
}
.lot_content .lot-level-1,
.lot-level-1 {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 350;
  color: var(--color-secondary);
  margin-bottom: 16px;
}
.lot_content .lot-level-1::after,
.lot-level-1::after {
  color: var(--color-accent);
}
.lot_footer {
  border-top: 0.5px solid var(--color-tertiary);
}
.lot_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-weight: 400;
  padding-top: 8px;
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  color: var(--color-tertiary);
  padding-top: 8px;
  margin: unset;
}
.lot_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-link);
}
.lot_footer_hr {
  border: 0.5px solid #2C343B;
  margin: 0;
  padding: 0;
}
.lot-body {
  column-count: 2;
  column-gap: 70px;
}
.lot_content,
.lot-body {
  padding-top: 0px;
  margin-top: 60px;
}