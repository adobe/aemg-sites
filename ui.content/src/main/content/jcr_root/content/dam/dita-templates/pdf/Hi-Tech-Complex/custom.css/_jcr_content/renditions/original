}
.pre-white-space.pre {
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-accent);
  background-color: var(--color-light-blue-bg);
  padding: 16px;
  border-radius: 10px;
  border: 0.5px solid var(--color-border);
  margin: 20px;
  max-width: 600px;
  word-wrap: break-word;
  white-space: pre-wrap;
  break-inside: avoid;
  font-family: 'Inter';
  background: #E8F1FF;
}
q,
.q {
    color: var(--color-primary);
    background-color: #E8F1FF;
    font-family: auto;
    border-left: none;
    padding: 16px 60px;
    position: relative;
    display: inline-block;
    font-weight: 400;
    font-size: 32px;
    line-height: 40px;
    letter-spacing: 0px;
    margin: 10px;
}
q::before,
.q::before {
    content: "“";
    font-size: 60px;
    color: var(--color-accent);
    position: absolute;
    top: unset;
    left: 27px;
}
q::after,
.q::after {
      content: "”";
    font-size: 60px;
    color: var(--color-accent);
    position: absolute;
    bottom: -0.1em;
    right: unset;
}
.dl {
  width: unset;
  margin-block: 2rem;
  padding: 1rem 0;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  /* border-radius: 8px; */
  /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); */
}
.dlhead {
