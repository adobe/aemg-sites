}
q,
.q {
  color: var(--color-primary);
  background-color: #B8E7CA;
  font-family: auto;
  border-left: none;
  padding: 16px 60px;
  position: relative;
  display: inline-block;
  font-weight: 400;
  font-size: var(--text-2xl);
  line-height: var(--text-2xl-lh);
  letter-spacing: 0px;
  margin: 20px 0px;
}
q::before,
.q::before {
  content: "“";
  font-size: 60px;
  color: var(--color-accent);
  position: absolute;
  top: unset;
  left: 27px;
}
q::after,
.q::after {
  content: "”";
  font-size: 60px;
  color: var(--color-accent);
  position: absolute;
  bottom: -0.1em;
  right: unset;
}
.dl {
