/* single line statement css*/
.restriction,
.note.caution,
.tip {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  padding: 8px 0px;
  border-top: 0.5px solid #D8D8D8;
  border-bottom: 0.5px solid #D8D8D8;
  border-left: unset;
  background-color: unset;
  margin: 45px 20px;
}
.note.danger {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  padding: 8px 0px;
  border-top: 0.5px solid #D8D8D8;
  border-bottom: 0.5px solid #D8D8D8;
  border-left: unset;
  background-color: unset;
  margin: 20px;
}
.note.danger .prefix-content,
.restriction .prefix-content,
.note.caution .prefix-content,
.tip .prefix-content {
  font-weight: bold;
  display: flex;
  gap: 8px;
  align-items: center;
  justify-content: flex-start;
}
.restriction .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/hi-tech/images/common/danger.png);
  background-size: 10px 10px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}
.note.caution .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/hi-tech/images/common/caution.png);
  background-size: 10px 10px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}
.tip .prefix-content::before {
  content: "";
  background-image: url(../../../aemguidesDALP/hi-tech/images/common/tip.png);
  background-size: 10px 10px;
  background-repeat: no-repeat;
  width: 24px;
  height: 24px;
  display: block;
  background-color: #B8E7CA;
  border-radius: 60px;
  background-position: center;
}
