/* Created with AEM Guides */
.cite,
cite,
term,
.term {
  color: var(--color-primary);
  font-style: italic;
  font-size: var(--text-base);
}
q,
.q {
  font-style: italic;
  font-size: var(--text-xl);
  border-left: 5px solid var(--color-accent);
  margin: 20px 0;
  padding-left: 20px;
  color: var(--color-primary);
  background-color: #E8F1FF;
  line-height: 1.6;
  font-family: var(--font-fam-primary);
  position: relative;
  border-left: none;
  padding: 14px 14px 14px 37px;
}
q::before,
.q::before {
  content: "“";
  font-size: 2em;
  color: var(--color-accent);
  position: absolute;
  top: 1px;
  left: 8px;
}
q::after,
.q::after {
  content: "”";
  font-size: 2em;
  color: var(--color-accent);
  position: absolute;
  bottom: -20px;
  right: 87%;
}
.dl {
  width: unset;
  margin-block: 2rem;
  padding: 1rem 0;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  /* border-radius: 8px; */
  /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); */
}
.dlhead {
  font-family: var(--font-fam-primary);
  color: var(--frontcover-text-color);
  margin-bottom: 1rem;
  font-weight: 400;
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  color: var(--color-primary);
}
.dthd {}
.dlentry {
  margin-bottom: 1rem;
  padding: 1rem;
  transition: all 0.3s ease;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  border-left: 3px solid var(--color-accent);
  background-color: #E8F1FF;
  color: var(--color-accent);
  break-inside: avoid;
}
.dt {
  font-weight: bold;
  color: var(--color-accent, #2c3e50);
  margin-bottom: 0.5rem;
  font-family: 'Inter';
  font-size: 18px;
}
.dt::after {
  content: " :";
}
dd {
  line-height: 1.5;
  margin-left: 1rem;
  font-family: 'Inter';
  color: var(--color-accent);
  font-size: 16px;
}
ol.steps {
  undefined: undefined;
  undefined: undefined;
  undefined: undefined;
  undefined: undefined;
  list-style: none;
  padding: 0;
  margin: 0;
  position: relative;
  max-width: 600px;
  margin: 30px auto;
  font-family: 'Helvetica N eue', sans-serif;
  counter-reset: step-counter;
}
li.step {
  undefined: undefined;
  undefined: undefined;
  position: relative;
  padding-left: 50px;
  margin-bottom: 40px;
  undefined: undefined;
  transition: transform 0.3s ease;
  font-size: var(--text-lg);
  line-height: var(--text-lg-lh);
  font-weight: 400;
  font-family: var(--font-fam-secondary);
  color: var(--color-primary);
}
ol.steps::before {
  content: '';
  position: absolute;
  top: 0;
  left: 25px;
  width: 2px;
  height: 100%;
  background-color: #76A2EB;
  z-index: 1;
}
li.step::before {
  content: counter(step-counter);
  counter-increment: step-counter;
  position: absolute;
  left: 8px;
  top: 16px;
  transform: translateY(-50%);
  width: 30px;
  height: 30px;
  background-color: white;
  color: var(--color-primary);
  font-weight: bold;
  font-size: 16px;
  border-radius: 50%;
  border: 3px solid var(--color-accent);
  text-align: center;
  line-height: 24px;
  z-index: 2;
}
li.step.active::before {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
li.step.completed::before {
  undefined: undefined;
  undefined: undefined;
  background-color: var(--color-accent);
  border-color: var(--color-accent);
  undefined: undefined;
}
div.itemgroup.info {
  background-color: #E8F1FF;
  padding: 10px;
  border-left: 2px solid var(--color-accent);
  font-size: 14px;
  margin-top: 10px;
  font-family: 'Inter';
  color: var(--color-accent);
}
span.prefix-content {
  font-weight: bold;
}
ul.choices {
  margin-top: 10px;
  padding-left: 20px;
  list-style-type: square;
}
li.choice {
  margin-bottom: 8px;
  font-size: 14px;
}
.ph.menucascade {
  padding: 5px;
  border-radius: 3px;
  margin-left: 5px;
  font-weight: 600;
}
.display-inline {
  display: inline-block;
  margin-right: 5px;
}
.ph.uicontrol {
  font-weight: normal;
  color: var(--color-primary);
}
.fig,
fig {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background-color: var(--color-grey-lighter, #f4f4f4);
  /* Subtle background */
  border-radius: 8px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  /* Light shadow for elegance */
  padding: 20px;
  max-width: 500px;
  margin: 30px auto;
  /* Centering with some margin */
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  /* Smooth transition */
}
.fig figcaption,
figcaption {
  font-size: 1.5em;
  font-weight: bold;
  color: var(--color-black-grey, #333);
  margin-top: 15px;
  font-family: 'Arial', sans-serif;
}
.image,
image {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
}
.fig {
  text-align: justify;
}
.fig .title,
.figcaption.title>.prefix-content::after {
  font-family: Adobe Clean;
  font-size: var(--text-base);
  font-weight: 400;
  line-height: var(--text-4xs-lh);
  text-align: left;
  color: var(--color-secondary);
  margin-bottom: 8px;
}
ul {
  list-style-type: none;
  padding-inline-start: 10px;
  margin-top: 50px;
}
ul li {
  background: white;
  border-radius: 5px;
  padding: 10px;
  transition: none;
  font-size: var(--text-sm);
  font-weight: 400;
  line-height: 18px;
  color: var(--color-accent);
  font-family: 'Inter';
}
ul li:not(.hazardstatement)::before {
  content: '•';
  position: relative;
  left: -28px;
  font-size: 1.5em;
  color: var(--color-accent, #821616);
}
.hazardstatement li::before,
.note.hazardstatement ul li::before {
  content: none;
}
.ol_container {
  /* background-color: var(--frontcover-text-color, #FFFFFF); */
  padding: 30px;
  border-radius: 8px;
  /* box-shadow: 0 0 8px rgba(2, 2, 2, 0.1); */
  width: 400px;
  margin: 0px;
  padding: 0px;
}
ol {
  list-style: none;
  padding: 0;
  counter-reset: list-counter;
  margin: 20px 0px; 
}
ol li {
  margin-bottom: 20px;
  counter-increment: list-counter;
  position: relative;
  padding-left: 50px;
  font-size: var(--text-sm);
  font-weight: 400;
  line-height: 18px;
  color: var(--color-accent);
  font-family: Inter;
}
ol li::before {
  color: var(--color-accent, green);
  border-color: var(--color-accent, green);
  content: counter(list-counter);
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 2px solid var(--color-accent, green);
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: bold;
  font-size: 1.2em;
}
ol li b {
  display: block;
  margin-bottom: 5px;
}
/* codeblock css  */
.codeblock.js .ph,
.codeblock.css .ph,
.codeblock.html .ph {
  color: black;
  font-family: inter;
  font-size: 14px;
  line-height: 20px;
}
.codeblock.js .codeph,
.codeblock.css .codeph,
.codeblock.html .codeph {
  color: black;
  font-family: inter;
  font-size: 14px;
  line-height: 20px;
  background: white;
  border: none;
}
.codeblock.js .codeph {
  color: brown;
}
.codeblock.css .codeph {
  color: blue;
}
.codeblock.html .codeph {
  color: red;
}
.codeblock.js,
.codeblock.css,
.codeblock.html {
  margin-bottom: 1rem;
  padding: 1rem;
  transition: all 0.3s ease;
  border: 1px solid var(--color-accent);
  background-color: white;
  break-inside: avoid;
}
.footnote-ref {
  font-size: 0.8em;
  color: var(--color-accent, #007bff);
  cursor: pointer;
  text-decoration: underline;
}
.footnote-ref:hover {
  color: var(--color-accent, #0056b3);
}
.footnote {
  font-size: 0.9em;
  margin-top: 1em;
  background-color: var(--color-footnote-light, #f8f9fa);
  padding: 10px;
  border-left: 4px solid var(--color-accent, #007bff);
  border-radius: 5px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  max-width: 600px;
  margin-left: 20px;
}
.footnote-text {
  margin: 0;
  font-style: italic;
}
.footnote-number {
  font-weight: bold;
  color: var(--color-accent, #0056b3);
}
.xrefinfo {
  margin-top: 20px;
  margin-bottom: 20px;
}
.p {
  margin-top: 15px;
  font-family: Arial, sans-serif;
  line-height: 1.6;
  margin-bottom: 15px;
}
.xref {
  color: #1E88E5;
  undefined: undefined;
  text-decoration: none;
  font-weight: bold;
}
