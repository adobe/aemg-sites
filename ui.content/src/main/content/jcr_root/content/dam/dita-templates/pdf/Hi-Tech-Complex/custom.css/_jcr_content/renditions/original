/* Created with AEM Guides */
.cite,
cite,
term,
.term {
  color: var(--color-primary);
  font-style: italic;
  font-size: var(--text-base);
}
q,
.q {
  font-style: italic;
  font-size: var(--text-xl);
  border-left: 5px solid var(--color-accent);
  margin: 20px 0;
  padding-left: 20px;
  color: var(--color-primary);
  background-color: #E8F1FF;
  line-height: 1.6;
  font-family: var(--font-fam-primary);
  position: relative;
  border-left: none;
  padding: 14px 14px 14px 37px;
}
q::before,
.q::before {
  content: "“";
  font-size: 3em;
  color: var(--color-accent);
  position: absolute;
  top: -12px;
  left: 4px;
}
q::after,
.q::after {
  content: "”";
  font-size: 3em;
  color: var(--color-accent);
  position: absolute;
  bottom: -41px;
  right: unset;
}
.dl {
  width: 60%;
  margin-block: 2rem;
  padding: 1rem 0;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  /* border-radius: 8px; */
  /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); */
}
.dlhead {
  font-family: var(--font-fam-primary);
  color: var(--frontcover-text-color);
  margin-bottom: 1rem;
  font-weight: 400;
  font-size: var(--text-base);
  line-height: var(--text-base-lh);
  color: var(--color-primary);
}
.dthd {}
.dlentry {
  margin-bottom: 1rem;
  padding: 1rem;
  transition: all 0.3s ease;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  border-left: 3px solid var(--color-primary);
  background-color: var(--color-neutral-light);
  color: var(--color-primary);
  break-inside: avoid;
}
.dt {
  font-weight: bold;
  color: var(--color-dark-grey, #2c3e50);
  margin-bottom: 0.5rem;
}
.dt::after {
  content: " :";
}
.dd {
  line-height: 1.5;
  margin-left: 1rem;
  font-family: var(--font-fam-secondary, var(--font-fam-primary));
  color: var(--color-secondary);
}
ol.steps {
  list-style: none;
  padding: 0;
  margin: 0;
  position: relative;
  max-width: 600px;
  /* Limit the width */
  margin: 30px auto;
  /* Center it */
  font-family: 'Helvetica Neue', sans-serif;
  counter-reset: step-counter;
  /* Initialize the counter */
}
li.step {
  position: relative;
  padding-left: 50px;
  /* Space for the vertical line and step icon */
  margin-bottom: 40px;
  /* Vertical spacing between steps */
  font-size: 18px;
  transition: transform 0.3s ease;
}
ol.steps::before {
  content: '';
  position: absolute;
  top: 0;
  left: 25px;
  /* Position the line in the center */
  width: 2px;
  height: 100%;
  background-color: var(--color-bg-light, #e0e0e0);
  z-index: 1;
}
li.step::before {
  content: counter(step-counter);
  counter-increment: step-counter;
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  width: 30px;
  height: 30px;
  background-color: var(--color-lighter-bg, #ccc);
  color: var(--color-primary);
  font-weight: bold;
  font-size: 16px;
  border-radius: 50%;
  border: 3px solid #fff;
  text-align: center;
  line-height: 30px;
  z-index: 2;
}
li.step.active::before {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
li.step.completed::before {
  background-color: var(--color-accent);
  /* Green for completed step */
  border-color: var(--color-accent);
  /* Border color for completed */
}
div.itemgroup.info {
  background-color: var(--color-white-light, #f3f3f3);
  padding: 10px;
  border-left: 3px solid var(--color-primary);
  font-size: 14px;
  margin-top: 10px;
}
span.prefix-content {
  font-weight: bold;
}
ul.choices {
  margin-top: 10px;
  padding-left: 20px;
  list-style-type: square;
}
li.choice {
  margin-bottom: 8px;
  font-size: 14px;
}
.ph.menucascade {
  padding: 5px;
  border-radius: 3px;
  margin-left: 5px;
  font-weight: 600;
}
.display-inline {
  display: inline-block;
  margin-right: 5px;
}
.ph.uicontrol {
  font-weight: normal;
  color: var(--color-primary);
}
.fig,
fig {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background-color: var(--color-grey-lighter, #f4f4f4);
  /* Subtle background */
  border-radius: 8px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  /* Light shadow for elegance */
  padding: 20px;
  max-width: 500px;
  margin: 30px auto;
  /* Centering with some margin */
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  /* Smooth transition */
}
.fig figcaption,
figcaption {
  font-size: 1.5em;
  font-weight: bold;
  color: var(--color-black-grey, #333);
  margin-top: 15px;
  font-family: 'Arial', sans-serif;
}
.image,
image {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
}
  .fig {
        text-align: justify;
  }
  .fig .title,
.fig figcaption .prefix-content::after {
  font-family: Adobe Clean;
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    text-align: left;
    color: color(--color-secondary);
    margin-bottom: 8px;
}
ul {
  list-style-type: none;
  padding-inline-start: 10px;
  margin-top: 50px;
}
ul li {
  background: var(--color-bg-light, #E7E7E7);
  border-radius: 5px;
  padding: 10px;
  transition: background-color 0.3s ease;
}
ul li:not(.hazardstatement)::before {
  content: '•';
  position: absolute;
  left: -20px;
  font-size: 1.5em;
  color: var(--color-accent, #821616);
}
.hazardstatement li::before,
.note.hazardstatement ul li::before {
  content: none;
}
.ol_container {
  background-color: var(--frontcover-text-color, #FFFFFF);
  padding: 30px;
  border-radius: 8px;
  box-shadow: 0 0 8px rgba(2, 2, 2, 0.1);
  width: 400px;
  margin: 30px;
  padding: 30px;
}
ol {
  list-style: none;
  padding: 0;
  counter-reset: list-counter;
}
ol li {
  margin-bottom: 20px;
  counter-increment: list-counter;
  position: relative;
  padding-left: 50px;
}
ol li::before {
  color: var(--color-accent, green);
  border-color: var(--color-accent, green);
  content: counter(list-counter);
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 2px solid var(--color-accent, green);
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: bold;
  font-size: 1.2em;
}
ol li b {
  display: block;
  margin-bottom: 5px;
}
.codeblock {
  margin-bottom: 1rem;
  padding: 1rem;
  transition: all 0.3s ease;
  font-size: var(--text-sm);
  line-height: var(--text-sm-lh);
  border: 2px solid var(--color-primary);
  background-color: var(--color-neutral-light);
  color: var(--color-primary);
  break-inside: avoid;
  font-size: 16px;
  line-height: 24px;
}
.footnote-ref {
  font-size: 0.8em;
  color: var(--color-accent, #007bff);
  cursor: pointer;
  text-decoration: underline;
}
.footnote-ref:hover {
  color: var(--color-accent, #0056b3);
}
.footnote {
  font-size: 0.9em;
  margin-top: 1em;
  background-color: var(--color-footnote-light, #f8f9fa);
  padding: 10px;
  border-left: 4px solid var(--color-accent, #007bff);
  border-radius: 5px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  max-width: 600px;
  margin-left: 20px;
}
.footnote-text {
  margin: 0;
  font-style: italic;
}
.footnote-number {
  font-weight: bold;
  color: var(--color-accent, #0056b3);
}
.xrefinfo {
  margin-top: 20px;
  margin-bottom: 20px;
}
.xref {
  color: var(--color-link, #0f85ec);
  text-decoration: underline;
}
