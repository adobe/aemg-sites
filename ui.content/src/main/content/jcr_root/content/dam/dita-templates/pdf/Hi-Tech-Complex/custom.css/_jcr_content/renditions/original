/* Style for <overline> */
.overline {
  border-top: 0.5px solid #000000;
  color: #D32F2F;
  /* Dark red color */
  font-weight: bold;
}
/* Style for <line-through> */
.line-through {
  text-decoration: line-through;
  color: #757575;
  /* Gray color for strike-through text */
  font-style: italic;
}
/* Style for <xref> links */
.xref:hover {
  text-decoration: underline;
}
/* Style for <u> (underline) */
.u {
  text-decoration: underline;
  color: #388E3C;
  /* Green color for underline */
  font-weight: bold;
}
/* Style for <i> (italic) */
.i {
  font-style: italic;
  color: #0288D1;
  /* Blue color for italic text */
  font-size: 1.1em;
}
/* Style for <b> (bold) */
.b {
  font-weight: bold;
  color: var(--color-accent);
  /* Orange color for bold text */
}
/* Style for <tt> (monospace) */
.tt {
  font-family: 'Courier New', Courier, monospace;
  background-color: #ECEFF1;
  /* Light gray background */
  padding: 0.2em 0.4em;
  border-radius: 4px;
}
/* Style for <sup> (superscript) */
.sup {
  font-size: 0.8em;
  vertical-align: super;
  color: #F44336;
  /* Red color for superscript */
}
/* Style for <sub> (subscript) */
.sub {
  font-size: 0.8em;
  vertical-align: sub;
  color: #2196F3;
  /* Blue color for subscript */
}
