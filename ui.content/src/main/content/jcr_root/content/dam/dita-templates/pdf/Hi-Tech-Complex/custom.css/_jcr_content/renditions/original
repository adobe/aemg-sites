}
ol.steps {
  list-style: none;
  padding: 0;
  margin: 0;
  position: relative;
  max-width: 600px;
  margin: 30px 0px;
  counter-reset: step-counter;
}
li.step {
  position: relative;
  padding-left: 50px;
  margin-bottom: 40px;
  undefined: undefined;
  transition: transform 0.3s ease;
  font-size: var(--text-lg);
  line-height: var(--text-lg-lh);
  font-weight: 400;
  font-family: var(--font-fam-secondary);
  color: var(--color-primary);
}
ol.steps::before {
  content: '';
  position: absolute;
  top: 2px;
  left: 23px;
  width: 1px;
  height: 100%;
  background-color: #D8D8D8;
  z-index: 1;
}
li.step::before {
  content: counter(step-counter);
  counter-increment: step-counter;
  position: absolute;
  left: 8px;
  top: 16px;
  width: 30px;
  height: 30px;
  background-color: #0C1256;
  color: #01EA57;
  border-radius: 50%;
  border: none;
  text-align: center;
  z-index: 2;
  font-family: Inter;
  font-weight: 700;
  font-size: 15px;
  line-height: 19.2px;
  letter-spacing: 0px;
}
li.step.active::before {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
li.step.completed::before {
  undefined: undefined;
  undefined: undefined;
  background-color: var(--color-accent);
  border-color: var(--color-accent);
  undefined: undefined;
}
.context {
  font-size: 14px;
