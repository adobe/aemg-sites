/*Created with AEM Guides*/
.chapter_header_title-landscape {
  font-family: PP Editorial New;
  font-size: 32px;
  font-weight: 400;
  line-height: 36px;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: #010101;
  margin-top: 15px;
}
.landscape-firstpage-section {
  display: flex;
  gap: 24px;
  margin-bottom: 40px;
}
.chapter_header_chapter-number-landscape {
  color: #010101;
  text-align: left;
  font-family: PP Editorial New;
  font-size: 32px;
  font-weight: 400;
  line-height: 36px;
  width: 100%;
  border-top: 0.5px solid #2C343B;
  display: inline-flex;
  width: 177px;
  padding-top: 4px;
  margin-bottom: 15px;
}
/* .section-content-landscape {
  display: flex;
  gap: 24px;
  margin-top: 30px;
} */
.content-img-landscape {
  height: 547px;
  width: 447px;
}
.landscape-section {
  width: 50%;
}
h1.title {
  font-family: PP Editorial New;
  font-size: 24px;
  font-weight: 400;
  line-height: 28px;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  color: var(--color-primary);
  border-top: 0.5px solid #2C343B;
  display: inline-block;
  padding-top: 4px;
  margin-bottom: 0px;
}
.title-and-no-landscape {
  display: flex;
  flex-direction: column;
  width: 50%;
  justify-content: space-between;
}
.chapter_footer_landscape {
  display: flex;
  justify-content: space-between;
  border-top: 0.5px solid #2C343B;
  color: var(--color-tertiary);
  align-items: center;
  padding-bottom: 0;
  margin-top: 40px;
}
.b {
  font-family: var(--font-fam-primary);
  font-size: inherit;
  font-weight: 400;
  line-height: var(--text-xl-lh);
  text-align: left;
  display: inline-block;
  padding-top: 0px;
}
.chapter_footer {
  margin-top: 40px;
}
h1.chapter.title {
  margin-bottom: 25px;
}

/* new css for lanscape content part  */
.portrait-image {
  display: none;
}
.landscape-image {
  height: 250px;
  display: block;
  width: 100%;
  margin-bottom: 24px;
}
.content-section {
  column-count: 2;
}