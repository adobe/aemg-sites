/* content-image start from here  */
.Images-content-section-container-landscape {
  display: flex;
  gap: unset;
  flex-direction: row;
}
.content-figure-image-landscape {
  margin-left: 0px;
  margin-right: 0px;
  margin-bottom: 40px;
  margin-top: 0px;
}
.content-figure-image-landscape .title,
figcaption.title>.prefix-content::after {
  font-family: Adobe Clean;
  font-size: var(--text-3xs);
  font-weight: 400;
  line-height: var(--text-4xs-lh);
  text-align: left;
  color: var(--color-tertiary);
  margin-bottom: 8px;
}
.images-main-container-landscape {
  display: flex;
  gap: 9px;
  width: 648px;
}
.image-num-container-landscape {
  background: #F2F2F2;
  height: 300px;
  width: 210px;
  padding: 14px 20px;
  display: flex;
  justify-content: space-between;
  flex-direction: column;
  box-sizing: border-box;
}
.image-num-container-landscape .number-landscape {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #0C1256;
  font-family: Urbanist;
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.image-num-container-landscape .resistor-image-landscape {
  width: 183px;
  height: 165px;
  opacity: 0px;
}
.content-section-landscape {
  margin-top: 26px;
  font-family: Inter;
  font-size: var(--text-sm);
  font-weight: 400;
  line-height: 20px;
  text-align: left;
  color: var(--color-accent);
  column-count: initial;
  column-gap: initial;
  padding-left: 80px;
}
.content-section-landscape div.p {
  column-count: initial;
  column-gap: initial;
}
.note-cont {
  display: flex;
  /* background: #E8F1FF; */
  font-family: Urbanist;
  font-size: var(--text-4xs);
  font-style: italic;
  font-weight: 400;
  line-height: 11px;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  margin: 27px 0px;
  /* padding: 27px 15px; */
}
.note-cont img {
  width: 24px;
  height: 24px;
}
.note-cont .note {
  border-left: unset;
  background-color: unset;
}
.p {
  column-count: initial;
  column-gap: initial;
  font-family: Inter;
  font-size: var(--text-sm);
  font-weight: 400;
  line-height: 18px;
  text-align: left;
  color: var(--color-accent);
}
.img-icon {
  height: 16px;
  width: 16px;
  margin-right: 8px;
}
.thead {
  background: aquamarine;
}