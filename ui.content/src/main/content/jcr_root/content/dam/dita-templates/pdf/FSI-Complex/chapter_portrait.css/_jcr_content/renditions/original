.content-card_img {
  height: 100%;
  width: 220px;
  margin-bottom: 36px;
  background-image: url('../../../aemguidesDALP/fsi/images/hsbc_content.jpg');
  background-size: 100% 100%;
}
.intro_heading {
  font-weight: 700;
  font-size: 40px;
  line-height: 51px;
  max-width: 100%;
  color: #2C343B;
  margin-bottom: 35px;
}
.intro_subheading {
  font-weight: 400;
  font-size: 18px;
  line-height: 23px;
  color: #2C343B;
  margin-bottom: 8px;
}
.intro_content {
  font-weight: 350;
  font-size: 12px;
  line-height: 16px;
  color: #013220;
  margin-bottom: 25px;
  margin-top: 20px;
}
.text-img-text-alignment {
  display: flex;
  column-gap: 20px;
  flex-wrap: wrap;
}
.width-25 {
  width: 25%;
}
.width-45 {
  width: 40%;
}
body {
  font-family: var(--font-fam-primary);
  font-size: 14px;
  line-height: 19.12px;
  font-weight: 400;
  color: #013220;
}
.chapter_header {
  display: flex;
  justify-content: space-between;
  border-bottom: 0.5px solid #AEAEAE;
  padding-bottom: 8px;
  /* margin-top: 30px;
  margin-bottom: 20px; */
}
.chapter_header-right {
  flex-direction: row-reverse;
  display: flex;
  justify-content: space-between;
  border-bottom: 0.5px solid #AEAEAE;
  padding-bottom: 8px;
}
.chapter_header_page-number {
  font-family: var(--font-fam-primary);
  font-size: 12px;
  line-height: 16px;
  font-weight: 400;
  color: #013220;
}
.chapter_header_logo {
  width: 33px;
  height: 17px;
}
.chapter_footer {
  padding-bottom: 24px;
  padding-top: 32px;
}
.chapter_footer_text_container {
  display: flex;
  gap: 4px;
  padding-bottom: 4px;
}
.chapter_footer_text {
  font-family: var(--font-fam-primary);
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin: 0;
}
.chapter_footer_number {
  font-family: var(--font-fam-primary);
  font-size: var(--text-4xs);
  line-height: var(--text-4xs-lh);
  font-weight: 400;
  color: var(--color-secondary);
  margin: 0;
}
.chapter_footer_urls {
  color: var(--color-secondary);
  text-decoration: none;
}
h1.title {
  font-family: var(--font-fam-primary);
  font-size: 24px;
  line-height: 32px;
  font-weight: 400;
  color: #013220;
  margin-bottom: 8px;
  margin-left: 10px;
}
h2.title {
  font-family: var(--font-fam-primary);
  font-size: 16px;
  line-height: 21.86px;
  font-weight: 400;
  color: #013220;
}
.shortdesc {
  font-family: var(--font-fam-primary);
  font-size: 16px;
  line-height: 24px;
  font-weight: 400;
  color: #013220;
  margin-bottom: 36px;
  padding-bottom: unset;
}
.link,
.topic a {
  font-family: var(--font-fam-primary);
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  color: #013220;
}
.thead {
  font-family: var(--font-fam-primary);
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  color: #0C1256;
  background-color: #E2F8F0;
  border: 0.5px solid #ACACAC;
  text-align: left;
}
b,
bold-text {
  font-weight: 700;
  color: #0C1256;
}
.tbody {
  font-family: var(--font-fam-primary);
  font-size: 11px;
  line-height: 14px;
  font-weight: 400;
  color: #454545;
  border: 0.5px solid #ACACAC;
}
.tbody .entry {
  font-family: var(--font-fam-primary);
  font-size: 11px;
  line-height: 14px;
  font-weight: 400;
  color: #454545;
}
.tbody b {
  font-family: var(--font-fam-primary);
  font-size: 11px;
  line-height: 14px;
  font-weight: 700;
  color: #454545;
  margin-bottom: 16px;
}
.table {
  margin-bottom: 40px;
}
ul {
  margin: 0;
  padding-inline-start: 20px;
}
li {
  font-family: var(--font-fam-primary);
  font-size: 11px;
  line-height: 14px;
  font-weight: 400;
  color: #454545;
  margin-bottom: 16px;
}
.entry {
  padding: 8px 16px;
  color: #013220;
}
/* chapter 1st page  */
.chapter_firstpage_header {
  display: none;
}
.chapter_firstpage_footer {
  display: none;
}
.chapter_firstpage_content {
  display: flex;
  height: 1124px;
}
.chapter_firstpage_content_left {
  background-color: #013220;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 80px 73px 201px 59px;
  flex-basis: 444px;
}
.chapter_firstpage_title {
  font-family: var(--font-fam-primary);
  font-size: 36px;
  line-height: 48px;
  font-weight: 500;
  color: #E8F1FF;
}
.chapter_firstpage_metadata {
  padding-right: 30px;
  width: 215px;
}
.chapter_firstpage_desc {
  font-family: var(--font-fam-primary);
  font-size: 24px;
  line-height: 33px;
  font-weight: 400;
  color: #E8F1FF;
  margin: 0;
}
.chapter_firstpage_descalt {
  font-family: var(--font-fam-primary);
  font-size: 14px;
  line-height: 19.12px;
  font-weight: 400;
  color: #E8F1FF;
  margin: 8px 0 0 0;
}
.chapter_firstpage_content_right {
  background-color: #C6DFD9;
  flex-basis: 350px;
  /* display: flex;
  flex-direction: column;
  justify-content: space-between; */
  padding-top: 82px;
  padding-left: 175px;
  box-sizing: border-box;
}
