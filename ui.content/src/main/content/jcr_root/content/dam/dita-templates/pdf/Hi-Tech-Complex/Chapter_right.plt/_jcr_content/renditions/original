<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <title>Right Chapter Page Layout</title>
  <link rel="stylesheet" href="layout.css" type="text/css" />
  <link rel="stylesheet" type="text/css" href="content.css" />
  <meta name="page-style" content="size:portrait;" />
  <meta name="footnote-style" content="margin-top:1rem;" />
</head>
<body data-layout="page">
  <div data-region="header">
    <p class="chapter-rightpage-lang">EN</p>
    <p class="chapter-rightpage-nums"><span data-field="chapter-number" data-format="default">1</span></p>
  </div>
  <div data-region="content"></div>
  <div data-region="footer">
    <div class="toc_footer" style="
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #E8F1FF;
    height: 72px;
    padding: 0px 73px;
    margin: 0;
    position: fixed;
    width: 100%;
    right: 0px;
    left: -73px;
">
      <p style="
    font-family: Urbanist;
    font-size: 14px;
    font-weight: 400;
    line-height: 16.8px;
    text-align: left;
    color: #0C1256;
"><span data-field="page-number" data-format="default">1</span></p>
      <p style="
    font-family: Adobe Clean;
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    text-align: left;
    color: #0C1256;
">Jetson AGX Orin Series Modules Tuning and Compliance Guide</p>
    </div>
  </div>
</body>
</html>