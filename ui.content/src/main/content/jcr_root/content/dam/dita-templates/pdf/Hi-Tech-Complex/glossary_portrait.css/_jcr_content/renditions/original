/*Created with AEM Guides*/
#glossary_header {
  margin-bottom: 0px;
  text-align: left;
}
#glossary_header_title {
  font-family: var(--font-fam-secondary);
  font-size: 1.3rem;
  line-height: 1.3rem;
  font-weight: 400;
  color: #000000;
  margin-bottom: 0px;
}
#glossary_header_titlealts {
  font-family: var(--font-fam-primay);
  font-size: 0.75rem;
  line-height: 0.875rem;
  font-weight: 400;
  color: #7F8794;
  margin-bottom: 40px;
  margin-top: 8px;
}
#glossary_footer_product-name {
font-family: var(--font-fam-secondary);
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    font-weight: 400;
    color: var(--color-accent);
    padding-top: 8px;
    margin: 0px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #E8F1FF;
    height: 72px;
    padding: 0px 73px;
    margin: 0;
    position: fixed;
    width: 100%;
    right: 0px;
    left: -73px;  
}
#glossary_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-link);
  text-decoration: none;
}
#glossary-footer {
  display: flex;
  flex-direction: column;
  align-items: baseline;
  row-gap: 1px;
  justify-content: flex-start;
  padding-bottom: 108px;
}
.glo-term {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  line-height: 1rem;
  font-weight: 700;
  color: #000000;
}
.glo-definition {
  font-family: var(--font-fam-secondary);
  font-size: 12px;
  font-weight: 350;
  line-height: 14px;
  text-align: left;
}
glossterm {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  line-height: 0.875rem;
  font-weight: 700;
  color: #000000;
}
.glo-body {
  display: grid;
  grid-template-columns: auto auto;
  grid-column-gap: 84px;
  grid-row-gap: 16px;
  margin-top: 30px;
}
.glo-unit {
  width: unset;
}
/* topic css  */
.left-right-main-container {
  display: flex;
  column-gap: 80px;
}
.left-side {
  width: 50%;
}
.left-side .left-side-image {
  width: 438px;
  height: 478px;
}
.right-side {
  width: 50%;
}