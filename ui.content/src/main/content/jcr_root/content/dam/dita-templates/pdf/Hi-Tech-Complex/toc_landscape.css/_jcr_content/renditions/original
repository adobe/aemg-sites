/*Created with AEM Guides*/
.rh-toc-page-wrapper>.topic-body {
  display: flex;
  gap: unset;
}
.toc_firstpage_cover-image {
  position: relative;
  top: -75px;
  width: 50%;
}
.toc_footer {
  font-family: var(--font-fam-secondary);
  font-size: var(--text-xs);
  line-height: var(--text-xs-lh);
  font-weight: 400;
  color: var(--color-accent);
  padding-top: 8px;
  margin: 0px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #E8F1FF;
  height: 72px;
  padding: 0px 73px;
  margin: 0;
  position: fixed;
  width: 100%;
  right: 0px;
  left: -73px;
  margin-top: 40px;
}
.toc_footer .toc_page_productname {
  font-family: Adobe Clean;
  font-size: var(--text-4xs);
  font-weight: 400;
  line-height: var(--text-4xs-lh);
  text-align: left;
  color: var(--color-accent);
}
.toc-body {
  margin-top: 53px;
  padding-left: 80px;
}
.toc-cover-img-landscape {
  width: 476px;
  height: 627px;
  object-fit: cover;
  object-position: top;
}
.toc-level-1 {
  font-family: Urbanist;
  font-size: var(--text-4xs-fs);
  font-weight: 700;
  line-height: var(--text-sm-fs);
  letter-spacing: 1px;
  text-align: left;
  color: var(--color-accent);
  margin-top: 22px;
}
.toc-level-2 {
  font-family: Urbanist;
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  letter-spacing: 0.05em;
  text-align: left;
  color: var(--color-accent);
  margin-top: 8px;
  text-indent: 0px;
  margin-inline-start: 15px;
}
.toc-level-2::after {
  color: var(--color-natural-blue);
  font-weight: 700;
  line-height: var(--text-xs-lh);
  letter-spacing: 0.05em;
  text-align: left;
  color: var(--color-accent);
}
.toc_title-landscpae {
  font-family: Urbanist;
  font-size: var(--text-2xl);
  font-weight: 500;
  line-height: var(--text-xl-lh);
  text-align: left;
  color: var(--color-primary-white);
  position: absolute;
  top: 526px;
  left: 0px;
  margin: 0;
  margin-left: 20px;
}