#toc_firstpage_header_title {
  font-family: var(--font-fam-secondary);
  font-size: 1.125rem;
  font-weight: 400;
  color: var(--title-color);
  line-height: 2rem;
  letter-spacing: -4%;
}
#toc_firstpage_header_titlealts {
  font-family: var(--font-fam-primary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--title-color);
  line-height: 0.75rem;
  letter-spacing: -4%;
}
#toc_firstpage_header_mainbooktitle {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--title-color);
  line-height: 0.75rem;
  letter-spacing: -4%;
}
#toc_firstpage_header_page-number {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--title-color);
  line-height: 1.5rem;
  letter-spacing: -4%;
  text-align: var(--page-number-text-align);
}
#toc_firstpage_footer_title {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: 0.75rem;
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_mainbooktitle {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: 0.75rem;
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_product-name {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: 0.75rem;
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_copyright {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: 0.75rem;
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_product-brand {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: 0.75rem;
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_page-number {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: 1.5rem;
  letter-spacing: var(--footerletter-spacing);
  text-align: var(--page-number-text-align);
}
#toc_firstpage_footer_urls {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--url-color);
  line-height: 0.75rem;
  letter-spacing: var(--footerletter-spacing);
  text-decoration: underline;
  text-decoration-style: solid;
  text-decoration-skip-ink: false;
}
#toc_firstpage_footer_version {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: 0.75rem;
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_email {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: 0.75rem;
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage_footer_organization {
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--footer-text-primary-color);
  line-height: 0.75rem;
  letter-spacing: var(--footerletter-spacing);
}
#toc_firstpage .toc-title {
  font-family: var(--font-fam-secondary);
  color: var(--color-primary);
  font-size: 1.25rem;
  font-weight: 400;
  line-height: 1.25rem;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  margin-bottom: 8px;
}
#toc_firstpage .toc-sub_title {
  font-family: var(--font-fam-primary);
  color: var(--color-tertiary);
  font-size: 0.75rem;
  font-weight: 400;
  line-height: 0.875rem;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  margin-bottom: 48px;
}
#toc_firstpage .toc-level-1 {
  text-transform: uppercase;
  font-family: var(--font-fam-secondary);
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1rem;
  text-align: left;
  text-decoration-skip-ink: none;
  color: var(--color-secondary);
  padding-top: 24px;
  margin-bottom: 5px;
  border: unset;
  padding-bottom: 4px;
  word-break: break-word;
  word-wrap: break-word;
  overflow-wrap: break-word;
  white-space: normal;
  letter-spacing: 0.5px;
}
#toc_firstpage .toc-level-1:nth-child(1) {
  padding-top: 0px;
}
#toc_firstpage .toc-level-2 {
  font-family: var(--font-fam-secondary);
  color: var(--color-tertiary);
  font-size: 0.75rem;
  font-weight: 400;
  line-height: 1rem;
  text-align: left;
  text-decoration-skip-ink: none;
  margin-bottom: 2px;
  padding-left: var(--toc-level-2-gap);
  padding-bottom: 2px;
}
#toc_firstpage .toc-level-3 {
  font-family: var(--font-fam-secondary);
  padding-left: var(--toc-level-3-gap);
  color: var(--color-tertiary);
  font-size: 0.75rem;
  font-weight: 400;
  line-height: 1rem;
  text-align: left;
  text-decoration-skip-ink: none;
  margin-bottom: 2px;
  padding-bottom: 2px;
}
#toc_firstpage .pdf-toc-level-1::after {
  color: var(--color-accent);
  padding-right: 20px;
  font-weight: 400;
}
#toc_firstpage .pdf-toc-level-2:after,
#toc_firstpage .pdf-toc-level-3:after,
#toc_firstpage .pdf-toc-level-4:after {
  color: var(--color-accent);
  padding-right: 20px;
}
#toc_firstpage .toc-body {
  column-count: 2;
  column-gap: 100px;
}
.toc-level-1,
.toc-level-2,
.toc-level-3,
.toc-level-4,
.toc-level-5,
.toc-level-6 {
  text-indent: 0px;
}