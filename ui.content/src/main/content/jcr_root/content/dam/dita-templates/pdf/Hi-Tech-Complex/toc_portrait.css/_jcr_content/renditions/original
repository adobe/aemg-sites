/*Created with AEM Guides*/
.rh-toc-page-wrapper>.topic-body {
  display: flex;
  gap: 24px;
}
.toc_firstpage_cover-image {
  position: relative;
  top: -75px;
  width: 50%;
}
.toc-body {
  margin-top: 53px;
}
.toc-cover-img {
  width: 312px;
  height: 411px;
  object-fit: cover;
  object-position: top;
}
.toc-level-1 {
  font-family: Urbanist;
  font-size: var(--text-4xs-fs);
  font-weight: 700;
  line-height: var(--text-sm-fs);
  letter-spacing: 0.05em;
  text-align: left;
  color: var(--color-accent);
  margin-top: 22px;
}
.toc-level-1::after {
  display: none;
}
.toc-level-2 {
  font-family: Urbanist;
  font-size: var(--text-4xs-fs);
  font-weight: 400;
  line-height: var(--text-xs-lh);
  letter-spacing: 0.05em;
  text-align: left;
  color: var(--color-accent);
  margin-top: 8px;
  text-indent: 0px;
}
.toc-level-2::after {
  color: var(--color-natural-blue);
}
.toc_title {
  font-family: Urbanist;
  font-size: var(--text-2xl-fs);
  font-weight: 500;
  line-height: var(--text-4xl-lh);
  text-align: left;
  color: var(--color-primary-white);
  position: absolute;
  bottom: 14%;
  left: 0px;
  padding-left: 19px;
  padding-bottom: 41px;
}