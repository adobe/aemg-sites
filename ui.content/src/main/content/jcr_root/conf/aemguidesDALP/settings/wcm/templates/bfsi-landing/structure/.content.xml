                        jcr:lastModified="{Date}2025-02-19T19:42:27.188+05:30"
                        jcr:lastModifiedBy="admin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>As part of our commitment to sustainability, has developed this Green Financing Framework to support projects that contribute to environmental sustainability. This framework aligns with international standards such as the Green Bond Principles (GBP) and the Green Loan Principles (GLP).&lt;/p>&#xd;&#xa;"
                        textIsRich="true"/>
                    <text_11628994
                        jcr:created="{Date}2025-02-19T17:40:53.588+05:30"
                        jcr:createdBy="admin"
                        jcr:lastModified="{Date}2025-02-19T19:44:46.810+05:30"
                        jcr:lastModifiedBy="admin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;h3>Objectives&lt;/h3>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>To support projects with clear environmental benefits&lt;/li>&#xd;&#xa;&lt;li>To align with international green finance standards, including the Green Bond Principles (GBP) and Green Loan Principles (GLP)&lt;/li>&#xd;&#xa;&lt;li>To promote transparency and accountability in the use of proceeds&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                        textIsRich="true"/>
                </container>
                <text
                    jcr:created="{Date}2025-02-19T18:24:25.320+05:30"
                    jcr:createdBy="admin"
                    jcr:lastModified="{Date}2025-02-20T12:03:23.697+05:30"
                    jcr:lastModifiedBy="admin"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="&lt;p>Project Evaluation &amp;amp; Selection&lt;/p>&#xd;&#xa;&lt;p>A dedicated Green Finance Committee will assess and approve projects based on their environmental benefits and alignment with green financing standards.&lt;/p>&#xd;&#xa;"
                    textIsRich="true"/>
                <list
                    jcr:created="{Date}2025-02-20T11:29:26.581+05:30"
