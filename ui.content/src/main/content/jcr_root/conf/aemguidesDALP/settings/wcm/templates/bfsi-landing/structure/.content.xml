                    jcr:lastModifiedBy="admin"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="&lt;p>Find out more about our&amp;nbsp;&lt;a href=&quot;#&quot;>Sustainable&amp;nbsp;Financing&lt;/a>&lt;/p>&#xd;&#xa;&lt;table cellpadding=&quot;1&quot; cellspacing=&quot;0&quot; border=&quot;1&quot; width=&quot;33%&quot;>&#xd;&#xa;&lt;tbody>&lt;tr>&lt;th scope=&quot;col&quot;>Issuer&lt;/th>&#xd;&#xa;&lt;th scope=&quot;col&quot;>Date&lt;/th>&#xd;&#xa;&lt;th scope=&quot;col&quot;>Title&lt;/th>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td>Bank Holdings&lt;/td>&#xd;&#xa;&lt;td>December 2024&lt;/td>&#xd;&#xa;&lt;td>Annual Green Impact Report&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td>Bank Holdings&lt;/td>&#xd;&#xa;&lt;td>December 2024&lt;/td>&#xd;&#xa;&lt;td>Green Finance Eligibility Criteria&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td>&amp;nbsp;&lt;/td>&#xd;&#xa;&lt;td>&amp;nbsp;&lt;/td>&#xd;&#xa;&lt;td>&amp;nbsp;&lt;/td>&#xd;&#xa;&lt;/tr>&lt;/tbody>&lt;/table>&#xd;&#xa;"
